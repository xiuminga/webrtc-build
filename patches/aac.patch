diff --git a/modules/audio_coding/codecs/aac/audio_encoder_aac_impl.cc b/modules/audio_coding/codecs/aac/audio_encoder_aac_impl.cc
new file mode 100644
index 0000000000..0f8c7e544c
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/audio_encoder_aac_impl.cc
@@
+#include "modules/audio_coding/codecs/aac/audio_encoder_aac_impl.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+#include "rtc_base/buffer.h"
+
+#if defined(WEBRTC_IOS)
+#include <AudioToolbox/AudioToolbox.h>
+#elif defined(WEBRTC_ANDROID)
+#include <media/NdkMediaCodec.h>
+#include <media/NdkMediaFormat.h>
+#include <sys/time.h>
+#endif
+
+namespace webrtc {
+
+AudioEncoderAacImpl::AudioEncoderAacImpl(const AudioEncoderAacConfig& config,
+                                         int payload_type,
+                                         const FieldTrialsView* field_trials)
+    : config_(config),
+      field_trials_(field_trials),
+      frames_per_packet_(config.frame_size_ms / 10),
+      payload_type_(payload_type)
+#if defined(WEBRTC_IOS)
+      ,
+      converter_(nullptr)
+#elif defined(WEBRTC_ANDROID)
+      ,
+      codec_(nullptr)
+#endif
+{
+  RTC_DCHECK(config_.IsOk());
+  InitPlatformEncoder();
+}
+
+AudioEncoderAacImpl::~AudioEncoderAacImpl() {
+#if defined(WEBRTC_IOS)
+  if (converter_) {
+    AudioConverterDispose(static_cast<AudioConverterRef>(converter_));
+  }
+#elif defined(WEBRTC_ANDROID)
+  if (codec_) {
+    AMediaCodec_stop(static_cast<AMediaCodec*>(codec_));
+    AMediaCodec_delete(static_cast<AMediaCodec*>(codec_));
+  }
+#endif
+}
+
+bool AudioEncoderAacImpl::InitPlatformEncoder() {
+#if defined(WEBRTC_IOS)
+  AudioStreamBasicDescription in_format = {};
+  in_format.mSampleRate = config_.sample_rate_hz;
+  in_format.mFormatID = kAudioFormatLinearPCM;
+  in_format.mFormatFlags = kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked;
+  in_format.mBitsPerChannel = 16;
+  in_format.mBytesPerFrame = 2 * config_.num_channels;
+  in_format.mBytesPerPacket = in_format.mBytesPerFrame;
+  in_format.mChannelsPerFrame = config_.num_channels;
+  in_format.mFramesPerPacket = 1;
+
+  AudioStreamBasicDescription out_format = {};
+  out_format.mSampleRate = config_.sample_rate_hz;
+  out_format.mFormatID = kAudioFormatMPEG4AAC;
+  out_format.mChannelsPerFrame = config_.num_channels;
+  out_format.mFramesPerPacket = 1024;
+
+  UInt32 out_size = sizeof(out_format);
+  AudioFormatGetProperty(kAudioFormatProperty_FormatInfo, 0, nullptr, &out_size,
+                         &out_format);
+
+  OSStatus status = AudioConverterNew(&in_format, &out_format,
+                                      reinterpret_cast<AudioConverterRef*>(&converter_));
+  if (status != noErr) {
+    RTC_LOG(LS_ERROR) << "AudioConverterNew failed: " << status;
+    converter_ = nullptr;
+    return false;
+  }
+  UInt32 bitrate = static_cast<UInt32>(config_.bitrate_bps);
+  status = AudioConverterSetProperty(static_cast<AudioConverterRef>(converter_),
+                                     kAudioConverterEncodeBitRate,
+                                     sizeof(bitrate), &bitrate);
+  if (status != noErr) {
+    RTC_LOG(LS_WARNING) << "AudioConverterSetProperty (bitrate) failed: " << status;
+  }
+  return true;
+#elif defined(WEBRTC_ANDROID)
+  codec_ = AMediaCodec_createEncoderByType("audio/mp4a-latm");
+  if (!codec_) {
+    RTC_LOG(LS_ERROR) << "Failed to create AAC MediaCodec encoder";
+    return false;
+  }
+  AMediaFormat* fmt = AMediaFormat_new();
+  AMediaFormat_setString(fmt, AMEDIAFORMAT_KEY_MIME, "audio/mp4a-latm");
+  AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_SAMPLE_RATE, config_.sample_rate_hz);
+  AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_CHANNEL_COUNT, config_.num_channels);
+  AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_BIT_RATE, config_.bitrate_bps);
+  AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_AAC_PROFILE, 2);  // LC
+  media_status_t r = AMediaCodec_configure(static_cast<AMediaCodec*>(codec_), fmt, nullptr,
+                                           nullptr, AMEDIACODEC_CONFIGURE_FLAG_ENCODE);
+  AMediaFormat_delete(fmt);
+  if (r != AMEDIA_OK) {
+    RTC_LOG(LS_ERROR) << "AMediaCodec_configure failed: " << r;
+    AMediaCodec_delete(static_cast<AMediaCodec*>(codec_));
+    codec_ = nullptr;
+    return false;
+  }
+  r = AMediaCodec_start(static_cast<AMediaCodec*>(codec_));
+  if (r != AMEDIA_OK) {
+    RTC_LOG(LS_ERROR) << "AMediaCodec_start failed: " << r;
+    AMediaCodec_delete(static_cast<AMediaCodec*>(codec_));
+    codec_ = nullptr;
+    return false;
+  }
+  return true;
+#else
+  return false;
+#endif
+}
+
+EncodedInfo AudioEncoderAacImpl::EncodeImpl(uint32_t rtp_timestamp,
+                                            rtc::ArrayView<const int16_t> audio,
+                                            rtc::Buffer* encoded) {
+  RTC_CHECK_EQ(
+      audio.size(),
+      static_cast<size_t>(config_.sample_rate_hz * config_.num_channels / 100));
+  pcm_buffer_.insert(pcm_buffer_.end(), audio.begin(), audio.end());
+  EncodedInfo info;
+  if (pcm_buffer_.size() <
+      frames_per_packet_ * config_.sample_rate_hz * config_.num_channels / 100) {
+    info.encoded_bytes = 0;
+    return info;
+  }
+
+  info = EncodePlatform(rtp_timestamp, pcm_buffer_, encoded);
+  pcm_buffer_.clear();
+  return info;
+}
+
+EncodedInfo AudioEncoderAacImpl::EncodePlatform(uint32_t rtp_timestamp,
+                                                rtc::ArrayView<const int16_t> audio,
+                                                rtc::Buffer* encoded) {
+  EncodedInfo info;
+#if defined(WEBRTC_IOS)
+  if (!converter_) {
+    info.encoded_bytes = 0;
+    return info;
+  }
+  const uint8_t* in_bytes = reinterpret_cast<const uint8_t*>(audio.data());
+  const UInt32 in_size = audio.size() * sizeof(int16_t);
+  // Conservative output buffer.
+  uint8_t out_buffer[4096] = {0};
+  UInt32 out_size = sizeof(out_buffer);
+  OSStatus st = AudioConverterConvertBuffer(
+      static_cast<AudioConverterRef>(converter_), in_size, in_bytes, &out_size,
+      out_buffer);
+  if (st != noErr) {
+    RTC_LOG(LS_ERROR) << "AudioConverterConvertBuffer failed: " << st;
+    info.encoded_bytes = 0;
+    return info;
+  }
+  encoded->SetData(out_buffer, out_size);
+  info.encoded_bytes = out_size;
+  info.payload_type = payload_type_;
+  info.encoded_timestamp = rtp_timestamp;
+  info.speech = true;
+  return info;
+#elif defined(WEBRTC_ANDROID)
+  if (!codec_) {
+    info.encoded_bytes = 0;
+    return info;
+  }
+  ssize_t index = AMediaCodec_dequeueInputBuffer(static_cast<AMediaCodec*>(codec_), 1000);
+  if (index >= 0) {
+    size_t buf_size = 0;
+    uint8_t* buf = AMediaCodec_getInputBuffer(static_cast<AMediaCodec*>(codec_), index, &buf_size);
+    size_t copy = std::min(buf_size, audio.size() * sizeof(int16_t));
+    memcpy(buf, audio.data(), copy);
+    int64_t pts_ns = static_cast<int64_t>(rtp_timestamp) * 1000000000LL /
+                     static_cast<int64_t>(config_.sample_rate_hz);
+    AMediaCodec_queueInputBuffer(static_cast<AMediaCodec*>(codec_), index, 0, copy,
+                                 pts_ns, 0);
+  }
+
+  AMediaCodecBufferInfo buffer_info;
+  index = AMediaCodec_dequeueOutputBuffer(static_cast<AMediaCodec*>(codec_), &buffer_info, 1000);
+  if (index >= 0) {
+    size_t out_size = 0;
+    uint8_t* out = AMediaCodec_getOutputBuffer(static_cast<AMediaCodec*>(codec_), index, &out_size);
+    encoded->SetData(out, buffer_info.size);
+    AMediaCodec_releaseOutputBuffer(static_cast<AMediaCodec*>(codec_), index, false);
+
+    info.encoded_bytes = buffer_info.size;
+    info.payload_type = payload_type_;
+    info.encoded_timestamp = rtp_timestamp;
+    info.speech = true;
+  } else {
+    info.encoded_bytes = 0;
+  }
+  return info;
+#else
+  encoded->Clear();
+  info.encoded_bytes = 0;
+  return info;
+#endif
+}
+
+void AudioEncoderAacImpl::Reset() {
+  pcm_buffer_.clear();
+  InitPlatformEncoder();
+}
+
+}  // namespace webrtc
