+++ b/api/audio_codecs/aac/audio_encoder_aac.cc
@@ -0,0 +1,61 @@
+/*
+ *  Copyright (c) 2024 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#include "api/audio_codecs/aac/audio_encoder_aac.h"
+
+#include <memory>
+#include <vector>
+
+#include "absl/strings/match.h"
+#include "modules/audio_coding/codecs/aac/audio_encoder_aac_impl.h"
+#include "rtc_base/checks.h"
+
+namespace webrtc {
+
+absl::optional<AudioEncoderAac::Config> AudioEncoderAac::SdpToConfig(
+    const SdpAudioFormat& format) {
+  if (!absl::EqualsIgnoreCase(format.name, "AAC")) {
+    return absl::nullopt;
+  }
+  
+  Config config;
+  config.sample_rate_hz = format.clockrate_hz;
+  config.num_channels = format.num_channels;
+  
+  // Default to 128 kbps bitrate
+  config.bitrate_bps = 128000;
+  
+  return config;
+}
+
+void AudioEncoderAac::AppendSupportedEncoders(
+    std::vector<AudioCodecSpec>* specs) {
+  const SdpAudioFormat fmt = {"AAC", 48000, 2, {{"profile-level-id", "1"}}};
+  const AudioCodecInfo info = QueryAudioEncoder(Config());
+  specs->push_back({fmt, info});
+}
+
+AudioCodecInfo AudioEncoderAac::QueryAudioEncoder(const Config& config) {
+  RTC_DCHECK(config.sample_rate_hz == 48000);
+  constexpr int kSampleRateHz = 48000;
+  constexpr int kFrameSizeMs = 20;
+  constexpr int kBitrateBps = 128000;
+  return {kSampleRateHz, config.num_channels,
+          kBitrateBps, kBitrateBps, kBitrateBps};
+}
+
+std::unique_ptr<AudioEncoder> AudioEncoderAac::MakeAudioEncoder(
+    const Config& config,
+    int payload_type,
+    absl::Nonnull<const FieldTrialsView*> field_trials) {
+  return AudioEncoderAacImpl::MakeAudioEncoder(config, payload_type);
+}
+
+}  // namespace webrtc
