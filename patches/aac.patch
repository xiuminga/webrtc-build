@@
+#ifndef API_AUDIO_CODECS_AAC_AUDIO_ENCODER_AAC_H_
+#define API_AUDIO_CODECS_AAC_AUDIO_ENCODER_AAC_H_
+
+#include <memory>
+#include <vector>
+
+#include "absl/types/optional.h"
+#include "api/audio_codecs/aac/audio_encoder_aac_config.h"
+#include "api/audio_codecs/audio_encoder_factory_template.h"
+#include "api/audio_codecs/audio_format.h"
+#include "api/field_trials_view.h"
+
+namespace webrtc {
+
+class AudioEncoder;
+
+class AudioEncoderAac {
+ public:
+  using Config = AudioEncoderAacConfig;
+
+  static absl::optional<Config> SdpToConfig(const SdpAudioFormat& format);
+  static void AppendSupportedEncoders(std::vector<AudioCodecSpec>* specs);
+  static AudioCodecInfo QueryAudioEncoder(const Config& config);
+  static std::unique_ptr<AudioEncoder> MakeAudioEncoder(
+      const Config& config,
+      int payload_type,
+      const FieldTrialsView* field_trials);
+};
+
+}  // namespace webrtc
+
+#endif  // API_AUDIO_CODECS_AAC_AUDIO_ENCODER_AAC_H_
diff --git a/api/audio_codecs/aac/audio_encoder_aac.cc b/api/audio_codecs/aac/audio_encoder_aac.cc
new file mode 100644
index 0000000000..b1e9cf2959
--- /dev/null
+++ b/api/audio_codecs/aac/audio_encoder_aac.cc
@@
+#include "api/audio_codecs/aac/audio_encoder_aac.h"
+
+#include <algorithm>
+#include <cctype>
+#include <string>
+
+#include "absl/strings/match.h"
+#include "api/audio_codecs/audio_format.h"
+#include "modules/audio_coding/codecs/aac/audio_encoder_aac_impl.h"
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+namespace {
+
+constexpr char kAacCodecName[] = "AAC";
+constexpr int kDefaultSampleRate = 48000;
+constexpr int kDefaultBitrateMono = 64000;
+constexpr int kDefaultBitrateStereo = 128000;
+
+bool IsAacFormat(const SdpAudioFormat& format) {
+  return absl::EqualsIgnoreCase(format.name, kAacCodecName) ||
+         absl::EqualsIgnoreCase(format.name, "MP4A-LATM") ||
+         absl::EqualsIgnoreCase(format.name, "MPEG4-GENERIC");
+}
+
+AudioCodecSpec CreateDefaultSpec(int channels) {
+  AudioCodecSpec spec;
+  spec.format = {kAacCodecName, kDefaultSampleRate, channels};
+  const int bitrate = channels == 1 ? kDefaultBitrateMono : kDefaultBitrateStereo;
+  spec.format.parameters = { {"bitrate", std::to_string(bitrate)} };
+  spec.info = {kDefaultSampleRate, channels, bitrate, 120, 120,
+               /*allow_comfort_noise=*/false, /*supports_network_adaptation=*/false};
+  return spec;
+}
+
+}  // namespace
+
+absl::optional<AudioEncoderAac::Config> AudioEncoderAac::SdpToConfig(
+    const SdpAudioFormat& format) {
+  if (!IsAacFormat(format)) {
+    return absl::nullopt;
+  }
+  Config config;
+  config.sample_rate_hz = format.clockrate > 0 ? format.clockrate : kDefaultSampleRate;
+  config.num_channels = format.num_channels > 0 ? format.num_channels : 2;
+  config.bitrate_bps =
+      config.num_channels == 1 ? kDefaultBitrateMono : kDefaultBitrateStereo;
+  auto it = format.parameters.find("bitrate");
+  if (it != format.parameters.end()) {
+    int bps = atoi(it->second.c_str());
+    if (bps > 0) {
+      config.bitrate_bps = bps;
+    }
+  }
+  return config;
+}
+
+void AudioEncoderAac::AppendSupportedEncoders(std::vector<AudioCodecSpec>* specs) {
+  RTC_DCHECK(specs);
+  specs->push_back(CreateDefaultSpec(1));
+  specs->push_back(CreateDefaultSpec(2));
+}
+
+AudioCodecInfo AudioEncoderAac::QueryAudioEncoder(const Config& config) {
+  RTC_DCHECK(config.IsOk());
+  const int bitrate = std::max(config.bitrate_bps,
+                               config.num_channels == 1 ? kDefaultBitrateMono
+                                                        : kDefaultBitrateStereo);
+  return AudioCodecInfo(config.sample_rate_hz, config.num_channels, bitrate,
+                        bitrate, bitrate);
+}
+
+std::unique_ptr<AudioEncoder> AudioEncoderAac::MakeAudioEncoder(
+    const Config& config,
+    int payload_type,
+    const FieldTrialsView* field_trials) {
+  RTC_DCHECK(config.IsOk());
+  return std::make_unique<AudioEncoderAacImpl>(config, payload_type, field_trials);
+}
+
+}  // namespace webrtc
