+#ifndef MODULES_AUDIO_CODING_CODECS_AAC_AUDIO_ENCODER_AAC_IMPL_H_
+#define MODULES_AUDIO_CODING_CODECS_AAC_AUDIO_ENCODER_AAC_IMPL_H_
+
+#include <vector>
+
+#include "absl/types/optional.h"
+#include "api/array_view.h"
+#include "api/audio_codecs/aac/audio_encoder_aac_config.h"
+#include "api/field_trials_view.h"
+#include "modules/audio_coding/codecs/audio_encoder.h"
+#include "rtc_base/system/rtc_export.h"
+
+namespace webrtc {
+
+class RTC_EXPORT AudioEncoderAacImpl : public AudioEncoder {
+ public:
+  AudioEncoderAacImpl(const AudioEncoderAacConfig& config,
+                      int payload_type,
+                      const FieldTrialsView* field_trials);
+  ~AudioEncoderAacImpl() override;
+
+  int SampleRateHz() const override { return config_.sample_rate_hz; }
+  size_t NumChannels() const override { return config_.num_channels; }
+  size_t Num10MsFramesInNextPacket() const override { return frames_per_packet_; }
+  size_t Max10MsFramesInAPacket() const override { return frames_per_packet_; }
+  int GetTargetBitrate() const override { return config_.bitrate_bps; }
+  EncodedInfo EncodeImpl(uint32_t rtp_timestamp,
+                         rtc::ArrayView<const int16_t> audio,
+                         rtc::Buffer* encoded) override;
+  void Reset() override;
+
+ private:
+  bool InitPlatformEncoder();
