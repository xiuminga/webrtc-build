+  const FieldTrialsView* const field_trials_;
+  const size_t frames_per_packet_;
+  int payload_type_;
+#if defined(WEBRTC_IOS)
+  void* converter_;  // AudioConverterRef
+#elif defined(WEBRTC_ANDROID)
