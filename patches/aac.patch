diff --git a/modules/audio_coding/codecs/aac/audio_decoder_aac_impl.cc b/modules/audio_coding/codecs/aac/audio_decoder_aac_impl.cc
new file mode 100644
index 0000000000..38bb38b2e3
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/audio_decoder_aac_impl.cc
@@
+#include "modules/audio_coding/codecs/aac/audio_decoder_aac_impl.h"
+
+#include <algorithm>
+#include <cstring>
+
+#include "rtc_base/logging.h"
+
+#if defined(WEBRTC_IOS)
+#include <AudioToolbox/AudioToolbox.h>
+#elif defined(WEBRTC_ANDROID)
+#include <media/NdkMediaCodec.h>
+#include <media/NdkMediaFormat.h>
+#endif
+
+namespace webrtc {
+
+AudioDecoderAacImpl::AudioDecoderAacImpl(const SdpAudioFormat& format)
+    : sample_rate_hz_(format.clockrate > 0 ? format.clockrate : 48000),
+      channels_(format.num_channels > 0 ? format.num_channels : 2)
+#if defined(WEBRTC_IOS)
+      ,
+      decoder_(nullptr)
+#elif defined(WEBRTC_ANDROID)
+      ,
+      codec_(nullptr)
+#endif
+{
+  InitPlatformDecoder();
+}
+
+AudioDecoderAacImpl::~AudioDecoderAacImpl() {
+#if defined(WEBRTC_IOS)
+  if (decoder_) {
+    AudioConverterDispose(static_cast<AudioConverterRef>(decoder_));
+  }
+#elif defined(WEBRTC_ANDROID)
+  if (codec_) {
+    AMediaCodec_stop(static_cast<AMediaCodec*>(codec_));
+    AMediaCodec_delete(static_cast<AMediaCodec*>(codec_));
+  }
+#endif
+}
+
+bool AudioDecoderAacImpl::InitPlatformDecoder() {
+#if defined(WEBRTC_IOS)
+  AudioStreamBasicDescription in_format = {};
+  in_format.mSampleRate = sample_rate_hz_;
+  in_format.mFormatID = kAudioFormatMPEG4AAC;
+  in_format.mChannelsPerFrame = channels_;
+
+  AudioStreamBasicDescription out_format = {};
+  out_format.mSampleRate = sample_rate_hz_;
+  out_format.mFormatID = kAudioFormatLinearPCM;
+  out_format.mFormatFlags = kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked;
+  out_format.mBitsPerChannel = 16;
+  out_format.mChannelsPerFrame = channels_;
+  out_format.mFramesPerPacket = 1;
+  out_format.mBytesPerFrame = 2 * channels_;
+  out_format.mBytesPerPacket = out_format.mBytesPerFrame;
+
+  OSStatus st = AudioConverterNew(&in_format, &out_format,
+                                  reinterpret_cast<AudioConverterRef*>(&decoder_));
+  if (st != noErr) {
+    RTC_LOG(LS_ERROR) << "AudioConverterNew (decoder) failed: " << st;
+    decoder_ = nullptr;
+    return false;
+  }
+  return true;
+#elif defined(WEBRTC_ANDROID)
+  codec_ = AMediaCodec_createDecoderByType("audio/mp4a-latm");
+  if (!codec_) {
+    RTC_LOG(LS_ERROR) << "Failed to create AAC decoder";
+    return false;
+  }
+  AMediaFormat* fmt = AMediaFormat_new();
+  AMediaFormat_setString(fmt, AMEDIAFORMAT_KEY_MIME, "audio/mp4a-latm");
+  AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_SAMPLE_RATE, sample_rate_hz_);
+  AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_CHANNEL_COUNT, static_cast<int32_t>(channels_));
+  media_status_t r =
+      AMediaCodec_configure(static_cast<AMediaCodec*>(codec_), fmt, nullptr, nullptr, 0);
+  AMediaFormat_delete(fmt);
+  if (r != AMEDIA_OK) {
+    RTC_LOG(LS_ERROR) << "AMediaCodec_configure decoder failed: " << r;
+    AMediaCodec_delete(static_cast<AMediaCodec*>(codec_));
+    codec_ = nullptr;
+    return false;
+  }
+  r = AMediaCodec_start(static_cast<AMediaCodec*>(codec_));
+  if (r != AMEDIA_OK) {
+    RTC_LOG(LS_ERROR) << "AMediaCodec_start decoder failed: " << r;
+    AMediaCodec_delete(static_cast<AMediaCodec*>(codec_));
+    codec_ = nullptr;
+    return false;
+  }
+  return true;
+#else
+  return false;
+#endif
+}
+
+int AudioDecoderAacImpl::DecodeInternal(const uint8_t* encoded,
+                                        size_t encoded_len,
+                                        int sample_rate_hz,
+                                        int16_t* decoded,
+                                        SpeechType* speech_type) {
+#if defined(WEBRTC_IOS)
+  if (!decoder_) {
+    return -1;
+  }
+  AudioBufferList out_list;
+  int16_t out_buffer[2048] = {0};
+  out_list.mNumberBuffers = 1;
+  out_list.mBuffers[0].mNumberChannels = channels_;
+  out_list.mBuffers[0].mDataByteSize = sizeof(out_buffer);
+  out_list.mBuffers[0].mData = out_buffer;
+
+  UInt32 out_frames = sizeof(out_buffer) / (channels_ * sizeof(int16_t));
+  struct UserData {
+    const uint8_t* data;
+    size_t size;
+  } user{encoded, encoded_len};
+  OSStatus st = AudioConverterFillComplexBuffer(
+      static_cast<AudioConverterRef>(decoder_),
+      [](AudioConverterRef, UInt32* io_num_packets, AudioBufferList* io_data,
+         AudioStreamPacketDescription**, void* user) -> OSStatus {
+        auto* state = static_cast<UserData*>(user);
+        if (state->size == 0) {
+          *io_num_packets = 0;
+          return -1;
+        }
+        io_data->mNumberBuffers = 1;
+        io_data->mBuffers[0].mData = const_cast<uint8_t*>(state->data);
+        io_data->mBuffers[0].mDataByteSize = state->size;
+        *io_num_packets = 1;
+        state->size = 0;
+        return noErr;
+      },
+      &user, &out_frames, &out_list, nullptr);
+
+  if (st != noErr) {
+    RTC_LOG(LS_ERROR) << "AAC decode failed: " << st;
+    return -1;
+  }
+  memcpy(decoded, out_buffer, out_frames * channels_ * sizeof(int16_t));
+  *speech_type = kSpeech;
+  return static_cast<int>(out_frames);
+#elif defined(WEBRTC_ANDROID)
+  if (!codec_) {
+    return -1;
+  }
+  ssize_t idx = AMediaCodec_dequeueInputBuffer(static_cast<AMediaCodec*>(codec_), 1000);
+  if (idx >= 0) {
+    size_t buf_size = 0;
+    uint8_t* buf =
+        AMediaCodec_getInputBuffer(static_cast<AMediaCodec*>(codec_), idx, &buf_size);
+    size_t copy = std::min(buf_size, encoded_len);
+    memcpy(buf, encoded, copy);
+    AMediaCodec_queueInputBuffer(static_cast<AMediaCodec*>(codec_), idx, 0, copy, 0, 0);
+  }
+  AMediaCodecBufferInfo info;
+  idx = AMediaCodec_dequeueOutputBuffer(static_cast<AMediaCodec*>(codec_), &info, 2000);
+  if (idx >= 0) {
+    size_t out_size = 0;
+    uint8_t* out =
+        AMediaCodec_getOutputBuffer(static_cast<AMediaCodec*>(codec_), idx, &out_size);
+    size_t samples = std::min(out_size / sizeof(int16_t), static_cast<size_t>(2048));
+    size_t samples_per_channel = samples / channels_;
+    memcpy(decoded, out, samples_per_channel * channels_ * sizeof(int16_t));
+    AMediaCodec_releaseOutputBuffer(static_cast<AMediaCodec*>(codec_), idx, false);
+    *speech_type = kSpeech;
+    return static_cast<int>(samples_per_channel);
+  }
+  return 0;
+#else
+  return -1;
+#endif
+}
+
+void AudioDecoderAacImpl::Reset() {
+#if defined(WEBRTC_IOS)
+  if (decoder_) {
+    AudioConverterReset(static_cast<AudioConverterRef>(decoder_));
+  }
+#elif defined(WEBRTC_ANDROID)
+  if (codec_) {
+    AMediaCodec_flush(static_cast<AMediaCodec*>(codec_));
+  }
+#endif
+}
