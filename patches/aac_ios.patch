diff --git a/modules/audio_coding/codecs/aac/ios/aac_platform_decoder_ios.mm b/modules/audio_coding/codecs/aac/ios/aac_platform_decoder_ios.mm
new file mode 100644
index 0000000000..df16790974c8
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/ios/aac_platform_decoder_ios.mm
@@ -0,0 +1,218 @@
+/*
+ *  Copyright (c) 2024 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#import "modules/audio_coding/codecs/aac/ios/aac_platform_decoder_ios.h"
+
+#include <AudioToolbox/AudioToolbox.h>
+
+#include <algorithm>
+#include <memory>
+
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+
+namespace {
+
+constexpr int kSupportedSampleRate = 48000;
+constexpr int kMaxChannels = 2;
+
+}  // namespace
+
+struct AacPlatformDecoderIos::Impl {
+  Config config;
+  AudioConverterRef audio_converter;
+  bool decoder_initialized;
+  std::vector<uint8_t> input_buffer;
+  size_t input_buffer_pos;
+  
+  Impl(const Config& cfg)
+      : config(cfg),
+        audio_converter(nullptr),
+        decoder_initialized(false),
+        input_buffer_pos(0) {}
+  
+  ~Impl() {
+    if (audio_converter) {
+      AudioConverterDispose(audio_converter);
+      audio_converter = nullptr;
+    }
+  }
+  
+  bool InitDecoder() {
+    RTC_LOG(LS_INFO) << "AacPlatformDecoderIos::InitDecoder() - "
+                     << "sample_rate=" << config.sample_rate_hz
+                     << " channels=" << config.num_channels;
+
+    // Setup input format (AAC)
+    AudioStreamBasicDescription input_format = {0};
+    input_format.mSampleRate = config.sample_rate_hz;
+    input_format.mFormatID = kAudioFormatMPEG4AAC;
+    input_format.mChannelsPerFrame = config.num_channels;
+
+    // Setup output format (PCM)
+    AudioStreamBasicDescription output_format = {0};
+    output_format.mSampleRate = config.sample_rate_hz;
+    output_format.mFormatID = kAudioFormatLinearPCM;
+    output_format.mFormatFlags = kLinearPCMFormatFlagIsSignedInteger |
+                                 kLinearPCMFormatFlagIsPacked;
+    output_format.mBytesPerPacket = 2 * config.num_channels;
+    output_format.mFramesPerPacket = 1;
+    output_format.mBytesPerFrame = 2 * config.num_channels;
+    output_format.mChannelsPerFrame = config.num_channels;
+    output_format.mBitsPerChannel = 16;
+
+    // Create audio converter
+    OSStatus status = AudioConverterNew(&input_format, &output_format,
+                                        &audio_converter);
+    if (status != noErr) {
+      RTC_LOG(LS_ERROR) << "Failed to create AudioConverter: " << status;
+      return false;
+    }
+
+    decoder_initialized = true;
+    return true;
+  }
+};
+
+AacPlatformDecoderIos::AacPlatformDecoderIos(const Config& config)
+    : impl_(std::make_unique<Impl>(config)) {
+  RTC_CHECK_EQ(config.sample_rate_hz, kSupportedSampleRate);
+  RTC_CHECK_LE(config.num_channels, kMaxChannels);
+  
+  impl_->InitDecoder();
+}
+
+AacPlatformDecoderIos::~AacPlatformDecoderIos() = default;
+
+int AacPlatformDecoderIos::SampleRateHz() const {
+  return impl_->config.sample_rate_hz;
+}
+
+size_t AacPlatformDecoderIos::Channels() const {
+  return impl_->config.num_channels;
+}
+
+// Input callback for AudioConverter
+OSStatus AacDecoderInputCallback(
+    AudioConverterRef inAudioConverter,
+    UInt32* ioNumberDataPackets,
+    AudioBufferList* ioData,
+    AudioStreamPacketDescription** outDataPacketDescription,
+    void* inUserData) {
+  auto* impl = static_cast<AacPlatformDecoderIos::Impl*>(inUserData);
+  
+  if (impl->input_buffer_pos >= impl->input_buffer.size()) {
+    *ioNumberDataPackets = 0;
+    return noErr;
+  }
+  
+  size_t remaining = impl->input_buffer.size() - impl->input_buffer_pos;
+  
+  ioData->mNumberBuffers = 1;
+  ioData->mBuffers[0].mNumberChannels = impl->config.num_channels;
+  ioData->mBuffers[0].mDataByteSize = remaining;
+  ioData->mBuffers[0].mData = impl->input_buffer.data() + impl->input_buffer_pos;
+  
+  *ioNumberDataPackets = 1;
+  impl->input_buffer_pos = impl->input_buffer.size();
+  
+  return noErr;
+}
+
+int AacPlatformDecoderIos::DecodeInternal(const uint8_t* encoded,
+                                           size_t encoded_len,
+                                           int sample_rate_hz,
+                                           int16_t* decoded,
+                                           SpeechType* speech_type) {
+  if (!impl_->decoder_initialized) {
+    RTC_LOG(LS_WARNING) << "AAC decoder not initialized";
+    return -1;
+  }
+
+  RTC_CHECK_EQ(sample_rate_hz, impl_->config.sample_rate_hz);
+
+  // Copy encoded data to input buffer
+  impl_->input_buffer.assign(encoded, encoded + encoded_len);
+  impl_->input_buffer_pos = 0;
+
+  // Prepare output buffer
+  const size_t max_output_samples = 2048 * impl_->config.num_channels;
+  std::vector<int16_t> output_buffer(max_output_samples);
+  
+  AudioBufferList output_buffer_list;
+  output_buffer_list.mNumberBuffers = 1;
+  output_buffer_list.mBuffers[0].mNumberChannels = impl_->config.num_channels;
+  output_buffer_list.mBuffers[0].mDataByteSize = 
+      max_output_samples * sizeof(int16_t);
+  output_buffer_list.mBuffers[0].mData = output_buffer.data();
+  
+  UInt32 output_packet_count = max_output_samples / impl_->config.num_channels;
+  
+  OSStatus status = AudioConverterFillComplexBuffer(
+      impl_->audio_converter,
+      AacDecoderInputCallback,
+      impl_.get(),
+      &output_packet_count,
+      &output_buffer_list,
+      nullptr);
+  
+  if (status != noErr || output_packet_count == 0) {
+    RTC_LOG(LS_WARNING) << "AAC decoding failed: " << status;
+    *speech_type = kSpeech;
+    return 0;
+  }
+  
+  // Copy decoded data
+  size_t decoded_samples = output_packet_count * impl_->config.num_channels;
+  std::copy_n(output_buffer.data(), decoded_samples, decoded);
+  
+  *speech_type = kSpeech;
+  
+  RTC_LOG(LS_VERBOSE) << "AAC decoded: encoded_len=" << encoded_len
+                      << " decoded_samples=" << decoded_samples;
+  
+  return decoded_samples;
+}
+
+void AacPlatformDecoderIos::Reset() {
+  RTC_LOG(LS_INFO) << "AacPlatformDecoderIos::Reset()";
+  
+  if (impl_->audio_converter) {
+    AudioConverterReset(impl_->audio_converter);
+  }
+  
+  impl_->input_buffer.clear();
+  impl_->input_buffer_pos = 0;
+}
+
+}  // namespace webrtc
