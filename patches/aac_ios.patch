index 0000000000..87c0641e11d6
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios.mm
@@ -0,0 +1,232 @@
+/*
+ *  Copyright (c) 2024 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#import "modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios.h"
+
+#include <AudioToolbox/AudioToolbox.h>
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+
+namespace {
+
+constexpr int kSupportedSampleRate = 48000;
+constexpr int kMaxChannels = 2;
+
+}  // namespace
+
+struct AacPlatformEncoderIos::Impl {
+  Config config;
+  int payload_type;
+  AudioConverterRef audio_converter;
+  bool encoder_initialized;
+  int64_t num_10ms_frames_per_packet;
+  std::vector<int16_t> input_buffer;
+  
+  Impl(const Config& cfg, int pt)
+      : config(cfg),
+        payload_type(pt),
+        audio_converter(nullptr),
+        encoder_initialized(false),
+        num_10ms_frames_per_packet(cfg.frame_size_ms / 10) {}
+  
+  ~Impl() {
+    if (audio_converter) {
+      AudioConverterDispose(audio_converter);
+      audio_converter = nullptr;
+    }
+  }
+  
+  bool InitEncoder() {
+    RTC_LOG(LS_INFO) << "AacPlatformEncoderIos::InitEncoder() - "
+                     << "sample_rate=" << config.sample_rate_hz
+                     << " channels=" << config.num_channels
+                     << " bitrate=" << config.bitrate_bps;
+
+    // Setup input format (PCM)
+    AudioStreamBasicDescription input_format = {0};
+    input_format.mSampleRate = config.sample_rate_hz;
+    input_format.mFormatID = kAudioFormatLinearPCM;
+    input_format.mFormatFlags = kLinearPCMFormatFlagIsSignedInteger |
+                                kLinearPCMFormatFlagIsPacked;
+    input_format.mBytesPerPacket = 2 * config.num_channels;
+    input_format.mFramesPerPacket = 1;
+    input_format.mBytesPerFrame = 2 * config.num_channels;
+    input_format.mChannelsPerFrame = config.num_channels;
+    input_format.mBitsPerChannel = 16;
+
+    // Setup output format (AAC)
+    AudioStreamBasicDescription output_format = {0};
+    output_format.mSampleRate = config.sample_rate_hz;
+    output_format.mFormatID = kAudioFormatMPEG4AAC;
+    output_format.mChannelsPerFrame = config.num_channels;
+
+    // Create audio converter
+    OSStatus status = AudioConverterNew(&input_format, &output_format,
+                                        &audio_converter);
+    if (status != noErr) {
+      RTC_LOG(LS_ERROR) << "Failed to create AudioConverter: " << status;
+      return false;
+    }
+
+    // Set bitrate
+    UInt32 output_bitrate = config.bitrate_bps;
+    status = AudioConverterSetProperty(
+        audio_converter, kAudioConverterEncodeBitRate,
+        sizeof(output_bitrate), &output_bitrate);
+    if (status != noErr) {
+      RTC_LOG(LS_WARNING) << "Failed to set bitrate: " << status;
+    }
+
+    encoder_initialized = true;
+    return true;
+  }
+};
+
+AacPlatformEncoderIos::AacPlatformEncoderIos(const Config& config,
+                                             int payload_type)
+    : impl_(std::make_unique<Impl>(config, payload_type)) {
+  RTC_CHECK_EQ(config.sample_rate_hz, kSupportedSampleRate);
+  RTC_CHECK_LE(config.num_channels, kMaxChannels);
+  RTC_CHECK_GT(config.bitrate_bps, 0);
+  
+  impl_->InitEncoder();
+}
+
+AacPlatformEncoderIos::~AacPlatformEncoderIos() = default;
+
+int AacPlatformEncoderIos::SampleRateHz() const {
+  return impl_->config.sample_rate_hz;
+}
+
+size_t AacPlatformEncoderIos::NumChannels() const {
+  return impl_->config.num_channels;
+}
+
+size_t AacPlatformEncoderIos::Num10MsFramesInNextPacket() const {
+  return impl_->num_10ms_frames_per_packet;
+}
+
+size_t AacPlatformEncoderIos::Max10MsFramesInAPacket() const {
+  return impl_->num_10ms_frames_per_packet;
+}
+
+int AacPlatformEncoderIos::GetTargetBitrate() const {
+  return impl_->config.bitrate_bps;
+}
+
+// Input callback for AudioConverter
+OSStatus AacEncoderInputCallback(
+    AudioConverterRef inAudioConverter,
+    UInt32* ioNumberDataPackets,
+    AudioBufferList* ioData,
+    AudioStreamPacketDescription** outDataPacketDescription,
+    void* inUserData) {
+  auto* impl = static_cast<AacPlatformEncoderIos::Impl*>(inUserData);
+  
+  if (impl->input_buffer.empty()) {
+    *ioNumberDataPackets = 0;
+    return noErr;
+  }
+  
+  ioData->mNumberBuffers = 1;
+  ioData->mBuffers[0].mNumberChannels = impl->config.num_channels;
+  ioData->mBuffers[0].mDataByteSize = impl->input_buffer.size() * sizeof(int16_t);
+  ioData->mBuffers[0].mData = impl->input_buffer.data();
+  
+  *ioNumberDataPackets = impl->input_buffer.size() / impl->config.num_channels;
+  
+  return noErr;
+}
+
+AudioEncoder::EncodedInfo AacPlatformEncoderIos::EncodeImpl(
+    uint32_t rtp_timestamp,
+    rtc::ArrayView<const int16_t> audio,
+    rtc::Buffer* encoded) {
+  EncodedInfo info;
+  info.encoded_timestamp = rtp_timestamp;
+  info.payload_type = impl_->payload_type;
+
+  if (!impl_->encoder_initialized) {
+    RTC_LOG(LS_WARNING) << "AAC encoder not initialized";
+    return info;
+  }
+
+  // Copy audio to input buffer
+  impl_->input_buffer.assign(audio.begin(), audio.end());
+
+  // Prepare output buffer
+  const size_t max_output_size = 2048;  // Typical AAC frame size
+  std::vector<uint8_t> output_buffer(max_output_size);
+  
+  AudioBufferList output_buffer_list;
+  output_buffer_list.mNumberBuffers = 1;
+  output_buffer_list.mBuffers[0].mNumberChannels = impl_->config.num_channels;
+  output_buffer_list.mBuffers[0].mDataByteSize = max_output_size;
+  output_buffer_list.mBuffers[0].mData = output_buffer.data();
+  
+  UInt32 output_packet_count = 1;
+  AudioStreamPacketDescription packet_desc;
+  
+  OSStatus status = AudioConverterFillComplexBuffer(
+      impl_->audio_converter,
+      AacEncoderInputCallback,
+      impl_.get(),
+      &output_packet_count,
+      &output_buffer_list,
+      &packet_desc);
+  
+  if (status != noErr || output_packet_count == 0) {
+    RTC_LOG(LS_WARNING) << "AAC encoding failed: " << status;
+    return info;
+  }
+  
+  // Copy encoded data
+  size_t encoded_bytes = output_buffer_list.mBuffers[0].mDataByteSize;
+  encoded->AppendData(output_buffer.data(), encoded_bytes);
+  
+  info.encoded_bytes = encoded_bytes;
+  
+  RTC_LOG(LS_VERBOSE) << "AAC encoded: timestamp=" << rtp_timestamp
+                      << " input_samples=" << audio.size()
+                      << " output_bytes=" << encoded_bytes;
+  
+  return info;
+}
+
+void AacPlatformEncoderIos::Reset() {
+  RTC_LOG(LS_INFO) << "AacPlatformEncoderIos::Reset()";
+  
+  if (impl_->audio_converter) {
+    AudioConverterReset(impl_->audio_converter);
+  }
+}
+
+}  // namespace webrtc
