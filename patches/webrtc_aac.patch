--- /dev/null
+++ b/modules/audio_coding/codecs/aac/BUILD.gn
@@ -0,0 +1,176 @@
+import("../../../../webrtc.gni")
+
+# Platform abstraction interface
+rtc_library("aac_platform_encoder_interface") {
+  visibility = [ "*" ]
+  sources = [
+    "platform/aac_platform_encoder.h",
+  ]
+
+  deps = [
+    "../../../../api:array_view",
+    "../../../../api/audio_codecs/aac:audio_encoder_aac_config",
+  ]
+}
