diff --git a/modules/audio_coding/codecs/aac/android/aac_platform_decoder_android.cc b/modules/audio_coding/codecs/aac/android/aac_platform_decoder_android.cc
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/android/aac_platform_decoder_android.cc
@@ -0,0 +1,320 @@
+#include "modules/audio_coding/codecs/aac/android/aac_platform_decoder_android.h"
+
+#include <media/NdkMediaCodec.h>
+#include <media/NdkMediaFormat.h>
+#include <android/log.h>
+
+#include "modules/audio_coding/codecs/aac/android/aac_platform_encoder_android.h"
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+#define LOG_TAG "AacPlatformDecoderAndroid"
+#define ALOGD(...) __android_log_print(ANDROID_LOG_DEBUG, LOG_TAG, __VA_ARGS__)
+#define ALOGE(...) __android_log_print(ANDROID_LOG_ERROR, LOG_TAG, __VA_ARGS__)
+
+namespace webrtc {
+
+namespace {
+
+// MediaCodec timeout in microseconds
+constexpr int64_t kTimeoutUs = 10000;  // 10ms
+
+// Maximum PCM buffer size (10 seconds at 48kHz stereo)
+constexpr size_t kMaxPcmBufferSize = 48000 * 2 * 10;
+
+}  // namespace
+
+std::unique_ptr<AacPlatformDecoderAndroid> AacPlatformDecoderAndroid::Create(
+    JavaVM* jvm,
+    const Settings& settings) {
+  auto decoder = std::make_unique<AacPlatformDecoderAndroid>(jvm, settings);
+  if (!decoder->InitializeMediaCodec()) {
+    ALOGE("Failed to initialize MediaCodec decoder");
+    return nullptr;
+  }
+  return decoder;
+}
+
+AacPlatformDecoderAndroid::AacPlatformDecoderAndroid(JavaVM* jvm,
+                                                     const Settings& settings)
+    : settings_(settings),
+      jni_helper_(std::make_unique<JniHelper>(jvm)) {
+  RTC_DCHECK(jni_helper_);
+  ALOGD("AacPlatformDecoderAndroid created: %d Hz, %zu ch",
+        settings_.sample_rate_hz, settings_.num_channels);
+}
+
+AacPlatformDecoderAndroid::~AacPlatformDecoderAndroid() {
+  ReleaseMediaCodec();
+  ALOGD("AacPlatformDecoderAndroid destroyed");
+}
+
+bool AacPlatformDecoderAndroid::InitializeMediaCodec() {
+  webrtc::MutexLock lock(&mutex_);
+  
+  ALOGD("Initializing MediaCodec for AAC-LC decoding");
+  
+  // Parse AudioSpecificConfig to get sample rate and channels
+  if (!ParseAudioSpecificConfig()) {
+    ALOGE("Failed to parse AudioSpecificConfig");
+    return false;
+  }
+  
+  // Create MediaFormat for AAC-LC
+  AMediaFormat* format = AMediaFormat_new();
+  if (!format) {
+    ALOGE("Failed to create AMediaFormat");
+    return false;
+  }
+  
+  // Configure AAC-LC format for decoding
+  AMediaFormat_setString(format, AMEDIAFORMAT_KEY_MIME, "audio/mp4a-latm");
+  AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_SAMPLE_RATE, settings_.sample_rate_hz);
+  AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_CHANNEL_COUNT, settings_.num_channels);
+  
+  // Set AudioSpecificConfig (CSD-0)
+  // Convert hex string to bytes
+  std::vector<uint8_t> csd0_bytes;
+  const std::string& hex = settings_.audio_specific_config_hex;
+  for (size_t i = 0; i < hex.length(); i += 2) {
+    std::string byte_str = hex.substr(i, 2);
+    uint8_t byte = static_cast<uint8_t>(std::stoi(byte_str, nullptr, 16));
+    csd0_bytes.push_back(byte);
+  }
+  
+  AMediaFormat_setBuffer(format, "csd-0", csd0_bytes.data(), csd0_bytes.size());
+  
+  ALOGD("MediaFormat configured: %d Hz, %zu ch, CSD-0: %s",
+        settings_.sample_rate_hz, settings_.num_channels,
+        settings_.audio_specific_config_hex.c_str());
+  
+  // Create MediaCodec decoder
+  AMediaCodec* codec = AMediaCodec_createDecoderByType("audio/mp4a-latm");
+  if (!codec) {
+    ALOGE("Failed to create MediaCodec decoder");
+    AMediaFormat_delete(format);
+    return false;
+  }
+  
+  // Configure MediaCodec
+  media_status_t status = AMediaCodec_configure(codec, format, nullptr, nullptr, 0);
+  AMediaFormat_delete(format);
+  
+  if (status != AMEDIA_OK) {
+    ALOGE("Failed to configure MediaCodec: %d", status);
+    AMediaCodec_delete(codec);
+    return false;
+  }
+  
+  // Start MediaCodec
+  status = AMediaCodec_start(codec);
+  if (status != AMEDIA_OK) {
+    ALOGE("Failed to start MediaCodec: %d", status);
+    AMediaCodec_delete(codec);
+    return false;
+  }
+  
+  // Store codec reference
+  media_codec_ = reinterpret_cast<jobject>(codec);
+  
+  // Allocate PCM buffer
+  pcm_buffer_.resize(kMaxPcmBufferSize);
+  
+  ALOGD("MediaCodec decoder initialized and started successfully");
+  return true;
+}
+
+void AacPlatformDecoderAndroid::ReleaseMediaCodec() {
+  webrtc::MutexLock lock(&mutex_);
+  
+  if (media_codec_) {
+    AMediaCodec* codec = reinterpret_cast<AMediaCodec*>(media_codec_);
+    AMediaCodec_stop(codec);
+    AMediaCodec_delete(codec);
+    media_codec_ = nullptr;
+    ALOGD("MediaCodec decoder released");
+  }
+  
+  pcm_buffer_.clear();
+}
+
+bool AacPlatformDecoderAndroid::ParseAudioSpecificConfig() {
+  // AudioSpecificConfig format (simplified for AAC-LC):
+  // "1190" = 0x1190 = 0001 0001 1001 0000
+  // - audioObjectType (5 bits): 00010 = 2 (AAC-LC)
+  // - samplingFrequencyIndex (4 bits): 0011 = 3 (48000 Hz)
+  // - channelConfiguration (4 bits): 0010 = 2 (Stereo)
+  
+  const std::string& hex = settings_.audio_specific_config_hex;
+  if (hex.length() < 4) {
+    ALOGE("Invalid AudioSpecificConfig: %s", hex.c_str());
+    return false;
+  }
+  
+  // Parse hex string to 16-bit value
+  uint16_t config = static_cast<uint16_t>(std::stoi(hex, nullptr, 16));
+  
+  // Extract fields
+  uint8_t audio_object_type = (config >> 11) & 0x1F;
+  uint8_t sampling_freq_index = (config >> 7) & 0x0F;
+  uint8_t channel_config = (config >> 3) & 0x0F;
+  
+  // Verify AAC-LC
+  if (audio_object_type != 2) {
+    ALOGE("Unsupported audio object type: %d (expected 2 for AAC-LC)", audio_object_type);
+    return false;
+  }
+  
+  // Map sampling frequency index to Hz
+  const int kSamplingFrequencies[] = {
+    96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050,
+    16000, 12000, 11025, 8000, 7350, 0, 0, 0
+  };
+  
+  if (sampling_freq_index >= 13) {
+    ALOGE("Invalid sampling frequency index: %d", sampling_freq_index);
+    return false;
+  }
+  
+  int sample_rate = kSamplingFrequencies[sampling_freq_index];
+  if (sample_rate != settings_.sample_rate_hz) {
+    ALOGD("AudioSpecificConfig sample rate (%d) differs from settings (%d), using config value",
+          sample_rate, settings_.sample_rate_hz);
+    settings_.sample_rate_hz = sample_rate;
+  }
+  
+  // Map channel configuration
+  if (channel_config != settings_.num_channels) {
+    ALOGD("AudioSpecificConfig channels (%d) differs from settings (%zu), using config value",
+          channel_config, settings_.num_channels);
+    settings_.num_channels = channel_config;
+  }
+  
+  ALOGD("Parsed AudioSpecificConfig: AAC-LC, %d Hz, %zu ch",
+        settings_.sample_rate_hz, settings_.num_channels);
+  
+  return true;
+}
+
+int AacPlatformDecoderAndroid::Decode(rtc::ArrayView<const uint8_t> aac_data,
+                                      rtc::ArrayView<int16_t> pcm_out) {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+  
+  if (!media_codec_) {
+    ALOGE("MediaCodec not initialized");
+    return -1;
+  }
+  
+  if (aac_data.empty()) {
+    ALOGE("Empty AAC data");
+    return -1;
+  }
+  
+  int samples_decoded = 0;
+  if (!DecodeInternal(aac_data.data(), aac_data.size(),
+                      pcm_out.data(), pcm_out.size(), &samples_decoded)) {
+    ALOGE("DecodeInternal failed");
+    return -1;
+  }
+  
+  return samples_decoded;
+}
+
+void AacPlatformDecoderAndroid::Reset() {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+  ALOGD("Reset called");
+  
+  ReleaseMediaCodec();
+  InitializeMediaCodec();
+}
+
+bool AacPlatformDecoderAndroid::DecodeInternal(const uint8_t* aac_data,
+                                                size_t aac_size,
+                                                int16_t* pcm_out,
+                                                size_t pcm_capacity,
+                                                int* samples_decoded) {
+  RTC_DCHECK(aac_data);
+  RTC_DCHECK(pcm_out);
+  RTC_DCHECK(samples_decoded);
+  RTC_DCHECK(media_codec_);
+  
+  AMediaCodec* codec = reinterpret_cast<AMediaCodec*>(media_codec_);
+  
+  // Get input buffer
+  ssize_t input_index = AMediaCodec_dequeueInputBuffer(codec, kTimeoutUs);
+  if (input_index < 0) {
+    ALOGE("Failed to dequeue input buffer: %zd", input_index);
+    return false;
+  }
+  
+  // Get input buffer pointer
+  size_t input_size = 0;
+  uint8_t* input_buffer = AMediaCodec_getInputBuffer(codec, input_index, &input_size);
+  if (!input_buffer) {
+    ALOGE("Failed to get input buffer");
+    return false;
+  }
+  
+  // Copy AAC data to input buffer
+  if (aac_size > input_size) {
+    ALOGE("AAC data too large: %zu > %zu", aac_size, input_size);
+    return false;
+  }
+  
+  memcpy(input_buffer, aac_data, aac_size);
+  
+  // Queue input buffer (PTS not critical for decoder)
+  media_status_t status = AMediaCodec_queueInputBuffer(
+      codec, input_index, 0, aac_size, 0, 0);
+  if (status != AMEDIA_OK) {
+    ALOGE("Failed to queue input buffer: %d", status);
+    return false;
+  }
+  
+  // Get output buffer
+  AMediaCodecBufferInfo info;
+  ssize_t output_index = AMediaCodec_dequeueOutputBuffer(codec, &info, kTimeoutUs);
+  
+  if (output_index >= 0) {
+    // Get output buffer pointer
+    size_t output_size = 0;
+    uint8_t* output_buffer = AMediaCodec_getOutputBuffer(codec, output_index, &output_size);
+    
+    if (output_buffer && info.size > 0) {
+      // Copy PCM data to output
+      size_t pcm_bytes = std::min(static_cast<size_t>(info.size),
+                                   pcm_capacity * sizeof(int16_t));
+      memcpy(pcm_out, output_buffer + info.offset, pcm_bytes);
+      
+      *samples_decoded = pcm_bytes / sizeof(int16_t) / settings_.num_channels;
+      
+      ALOGD("Decoded AAC frame: %d samples/ch, %d bytes",
+            *samples_decoded, info.size);
+    }
+    
+    // Release output buffer
+    AMediaCodec_releaseOutputBuffer(codec, output_index, false);
+    return true;
+    
+  } else if (output_index == AMEDIACODEC_INFO_TRY_AGAIN_LATER) {
+    // No output available yet
+    ALOGD("No output available yet (TRY_AGAIN_LATER)");
+    *samples_decoded = 0;
+    return true;
+    
+  } else if (output_index == AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED) {
+    // Output format changed
+    AMediaFormat* format = AMediaCodec_getOutputFormat(codec);
+    ALOGD("Output format changed");
+    AMediaFormat_delete(format);
+    *samples_decoded = 0;
+    return true;
+    
+  } else {
+    ALOGE("Unexpected output index: %zd", output_index);
+    return false;
+  }
+}
+
+}  // namespace webrtc
+

