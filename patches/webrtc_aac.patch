+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#include "api/audio_codecs/aac/audio_encoder_aac.h"
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "api/audio_codecs/audio_encoder.h"
+#include "api/audio_codecs/audio_encoder_factory.h"
+#include "api/audio_codecs/audio_format.h"
+#include "api/audio_codecs/aac/audio_encoder_aac_config.h"
+#include "modules/audio_coding/codecs/aac/audio_encoder_aac_impl.h"
+#include "absl/strings/match.h"
+#include "rtc_base/checks.h"
+#include "rtc_base/string_to_number.h"
+
+namespace webrtc {
+
+std::optional<AudioEncoderAacConfig> AudioEncoderAac::SdpToConfig(
+    const SdpAudioFormat& format) {
+  if (!absl::EqualsIgnoreCase(format.name, "mpeg4-generic")) {
+    return std::nullopt;
+  }
+
+  AudioEncoderAacConfig config;
+  config.sample_rate_hz = format.clockrate_hz;
+  config.num_channels = format.num_channels;
+  
+  // Parse bitrate from format parameters
+  auto bitrate_param = format.parameters.find("bitrate");
+  if (bitrate_param != format.parameters.end()) {
+    auto bitrate = rtc::StringToNumber<int>(bitrate_param->second);
+    if (bitrate.has_value()) {
+      config.bitrate_bps = bitrate.value();
+    }
+  }
+
+  auto asc_param = format.parameters.find("config");
+  if (asc_param != format.parameters.end()) {
+    config.audio_specific_config_hex = asc_param->second;
+  }
+
+  if (!config.IsOk()) {
+    return std::nullopt;
+  }
+  
+  return config;
+}
+
+void AudioEncoderAac::AppendSupportedEncoders(
+    std::vector<AudioCodecSpec>* specs) {
+  // AAC-LC 48kHz stereo, 128kbps
+  CodecParameterMap params_48k;
+  params_48k["profile-level-id"] = "1";
+  params_48k["mode"] = "AAC-hbr";
+  params_48k["sizelength"] = "13";
+  params_48k["indexlength"] = "3";
+  params_48k["indexdeltalength"] = "3";
+  params_48k["config"] = kAacDefaultAudioSpecificConfigHex;  // AAC-LC 48kHz stereo
+  
+  SdpAudioFormat format_48k(cricket::kAacCodecName, 48000, 2, params_48k);
+  AudioCodecInfo info_48k(48000, 2, 128000, 32000, 256000);
+  info_48k.allow_comfort_noise = false;
+  info_48k.supports_network_adaption = true;
+  specs->push_back({format_48k, info_48k});
+}
+
+AudioCodecInfo AudioEncoderAac::QueryAudioEncoder(
+    const AudioEncoderAacConfig& config) {
+  RTC_DCHECK(config.IsOk());
+  return AudioCodecInfo(config.sample_rate_hz, config.num_channels,
+                       config.bitrate_bps, 32000, 256000);
+}
+
+std::unique_ptr<AudioEncoder> AudioEncoderAac::MakeAudioEncoder(
+    const Environment& env,
+    const AudioEncoderAacConfig& config,
+    const AudioEncoderFactory::Options& options) {
+  if (!config.IsOk()) {
+    RTC_DCHECK_NOTREACHED();
+    return nullptr;
+  }
+  return std::make_unique<AudioEncoderAacImpl>(env, config,
+                                              options.payload_type);
+}
+
+}  // namespace webrtc

