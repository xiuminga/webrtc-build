+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#import "modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios.h"
+
+#include <vector>
+
+#include "api/audio_codecs/aac/audio_encoder_aac_config.h"
+#include "rtc_base/gunit.h"
+
+namespace webrtc {
+namespace {
+
+class AacPlatformEncoderIOSTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    AacPlatformEncoderIOS::Settings settings;
+    settings.sample_rate_hz = 48000;
+    settings.num_channels = 2;
+    settings.bitrate_bps = 128000;
+    encoder_ = AacPlatformEncoderIOS::Create(settings);
+  }
+
+  std::unique_ptr<AacPlatformEncoderIOS> encoder_;
+};
+
+TEST_F(AacPlatformEncoderIOSTest, CreatesEncoder) {
+  ASSERT_NE(encoder_, nullptr);
+}
+
+TEST_F(AacPlatformEncoderIOSTest, EncodesFrame) {
+  // Create 1024 samples (AAC frame size) of stereo PCM data
+  const size_t kSamplesPerChannel = 1024;
+  const size_t kNumChannels = 2;
+  std::vector<int16_t> pcm_data(kSamplesPerChannel * kNumChannels, 0);
+  
+  // Fill with simple sine wave pattern
+  for (size_t i = 0; i < pcm_data.size(); ++i) {
+    pcm_data[i] = static_cast<int16_t>(1000 * sin(2.0 * M_PI * i / 100.0));
+  }
+
+  auto frame = encoder_->Encode(
+      rtc::ArrayView<const int16_t>(pcm_data.data(), pcm_data.size()),
+      kNumChannels, 48000);
+
+  EXPECT_TRUE(frame.success);
+  EXPECT_GT(frame.aac_data.size(), 0u);
+}
+
+TEST_F(AacPlatformEncoderIOSTest, OutputDoesNotContainADTSHeader) {
+  // Create PCM data
+  const size_t kSamplesPerChannel = 1024;
+  const size_t kNumChannels = 2;
+  std::vector<int16_t> pcm_data(kSamplesPerChannel * kNumChannels, 0);
+  
+  for (size_t i = 0; i < pcm_data.size(); ++i) {
+    pcm_data[i] = static_cast<int16_t>(5000 * sin(2.0 * M_PI * i / 50.0));
+  }
+
+  auto frame = encoder_->Encode(
+      rtc::ArrayView<const int16_t>(pcm_data.data(), pcm_data.size()),
+      kNumChannels, 48000);
+
+  ASSERT_TRUE(frame.success);
+  ASSERT_GT(frame.aac_data.size(), 0u);
+
+  // Verify ADTS header is NOT present
+  // ADTS sync word is 0xFFF (first 12 bits)
+  const uint8_t* data = frame.aac_data.data();
+  bool has_adts = (data[0] == 0xFF) && ((data[1] & 0xF0) == 0xF0);
+  
+  EXPECT_FALSE(has_adts) << "AAC output should not contain ADTS header";
+}
+
+TEST_F(AacPlatformEncoderIOSTest, AudioSpecificConfigIsValid) {
+  const std::string& config_hex = encoder_->audio_specific_config_hex();
+  
+  // Should be kAacDefaultAudioSpecificConfigHex for AAC-LC 48kHz stereo
+  // 0x1190 = 0001 0001 1001 0000
+  // Bits 0-4: audioObjectType = 2 (AAC-LC)
+  // Bits 5-8: samplingFrequencyIndex = 3 (48000Hz)
+  // Bits 9-12: channelConfiguration = 2 (Stereo)
+  EXPECT_EQ(config_hex, kAacDefaultAudioSpecificConfigHex);
+}
+
+TEST_F(AacPlatformEncoderIOSTest, EncodesMultipleFrames) {
+  const size_t kSamplesPerChannel = 1024;
+  const size_t kNumChannels = 2;
+  std::vector<int16_t> pcm_data(kSamplesPerChannel * kNumChannels, 0);
+
+  // Encode 10 frames
+  for (int frame_num = 0; frame_num < 10; ++frame_num) {
+    // Generate different pattern for each frame
+    for (size_t i = 0; i < pcm_data.size(); ++i) {
+      pcm_data[i] = static_cast<int16_t>(
+          3000 * sin(2.0 * M_PI * (i + frame_num * 100) / 80.0));
+    }
+
+    auto frame = encoder_->Encode(
+        rtc::ArrayView<const int16_t>(pcm_data.data(), pcm_data.size()),
+        kNumChannels, 48000);
+
+    EXPECT_TRUE(frame.success) << "Frame " << frame_num << " encoding failed";
+    EXPECT_GT(frame.aac_data.size(), 0u) << "Frame " << frame_num << " has no data";
+    
+    // Verify no ADTS header
+    const uint8_t* data = frame.aac_data.data();
+    bool has_adts = (data[0] == 0xFF) && ((data[1] & 0xF0) == 0xF0);
+    EXPECT_FALSE(has_adts) << "Frame " << frame_num << " contains ADTS header";
+  }
+}
+
+}  // namespace
+}  // namespace webrtc
+

