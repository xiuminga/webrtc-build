+++ b/api/audio_codecs/aac/audio_decoder_aac_impl.cc
@@ -0,0 +1,161 @@
+/*
+ *  Copyright (c) 2024 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#include "api/audio_codecs/aac/audio_decoder_aac_impl.h"
+
+#include "modules/audio_coding/codecs/aac/aac_platform_decoder.h"
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+
+AudioDecoderAacImpl::AudioDecoderAacImpl(const AudioEncoderAacConfig& config)
+    : config_(config) {
+  RTC_CHECK(config.IsOk());
+}
+
+AudioDecoderAacImpl::~AudioDecoderAacImpl() = default;
+
+std::vector<AudioDecoder::ParseResult> AudioDecoderAacImpl::ParsePayload(
+    rtc::Buffer&& payload,
+    uint32_t timestamp) {
+  std::vector<ParseResult> results;
+
+  if (payload.size() < 4) {
+    RTC_LOG(LS_WARNING) << "AAC payload too short: " << payload.size();
+    return results;
+  }
+
+  // Parse RFC 3640 AAC-hbr header
+  const uint8_t* data = payload.data();
+
+  // AU-headers-length (16 bits)
+  uint16_t au_headers_length = (data[0] << 8) | data[1];
+
+  if (au_headers_length != 0x0010) {
+    RTC_LOG(LS_ERROR) << "Unexpected AU-headers-length: "
+                      << au_headers_length;
+    return results;
+  }
+
+  // AU-header: size (13 bits) + index (3 bits)
+  uint16_t au_header = (data[2] << 8) | data[3];
+  uint16_t aac_size = (au_header >> 3);  // Extract 13-bit size
+
+  // Validate size
+  size_t expected_size = aac_size;
+  size_t actual_payload_size = payload.size() - 4;  // Minus 4-byte header
+
+  if (expected_size != actual_payload_size) {
+    RTC_LOG(LS_WARNING) << "AU-header size mismatch: expected "
+                        << expected_size << ", got " << actual_payload_size;
+    // Continue anyway - use actual payload size
+  }
+
+  // Extract AAC payload (skip 4-byte RFC 3640 header)
+  rtc::Buffer aac_payload(data + 4, payload.size() - 4);
+
+  // Create encoded frame
+  auto frame = std::make_unique<EncodedFrame>(this, std::move(aac_payload));
+
+  ParseResult result;
+  result.timestamp = timestamp;
+  result.priority = 0;
+  result.frame = std::move(frame);
+
+  results.push_back(std::move(result));
+  return results;
+}
+
+int AudioDecoderAacImpl::SampleRateHz() const {
+  return config_.sample_rate_hz;
+}
+
+size_t AudioDecoderAacImpl::Channels() const {
+  return config_.num_channels;
+}
+
+void AudioDecoderAacImpl::Reset() {
+  if (platform_decoder_) {
+    platform_decoder_->Reset();
+  }
+}
+
+int AudioDecoderAacImpl::DecodeInternal(const uint8_t* encoded,
+                                         size_t encoded_len,
+                                         int sample_rate_hz,
+                                         int16_t* decoded,
+                                         SpeechType* speech_type) {
+  if (!platform_decoder_) {
+    AacPlatformDecoder::Settings settings;
+    settings.sample_rate_hz = config_.sample_rate_hz;
+    settings.num_channels = config_.num_channels;
+    settings.audio_specific_config_hex = config_.audio_specific_config_hex;
+
+    platform_decoder_ = AacPlatformDecoder::Create(settings);
+    if (!platform_decoder_) {
+      RTC_LOG(LS_ERROR) << "Failed to create AAC platform decoder";
+      return -1;
+    }
+  }
+
+  rtc::ArrayView<const uint8_t> aac_data(encoded, encoded_len);
+
+  // AAC-LC outputs 1024 samples per frame per channel
+  size_t max_samples = 1024 * config_.num_channels;
+  rtc::ArrayView<int16_t> pcm_out(decoded, max_samples);
+
+  int samples_per_channel = platform_decoder_->Decode(aac_data, pcm_out);
+
+  if (samples_per_channel < 0) {
+    RTC_LOG(LS_ERROR) << "AAC decode failed";
+    return -1;
+  }
+
+  *speech_type = kSpeech;
+
+  // Return total number of samples (all channels)
+  return samples_per_channel * config_.num_channels;
+}
+
+// EncodedFrame implementation
+
+AudioDecoderAacImpl::EncodedFrame::EncodedFrame(AudioDecoderAacImpl* decoder,
+                                                 rtc::Buffer&& payload)
+    : decoder_(decoder), payload_(std::move(payload)) {}
+
+size_t AudioDecoderAacImpl::EncodedFrame::Duration() const {
+  // AAC-LC frame always outputs 1024 samples per channel
+  return 1024;
+}
+
+std::optional<AudioDecoder::EncodedAudioFrame::DecodeResult>
+AudioDecoderAacImpl::EncodedFrame::Decode(
+    rtc::ArrayView<int16_t> decoded) const {
+  AudioDecoder::SpeechType speech_type;
+
+  int total_samples = decoder_->DecodeInternal(
+      payload_.data(),
+      payload_.size(),
+      decoder_->SampleRateHz(),
+      decoded.data(),
+      &speech_type);
+
+  if (total_samples < 0) {
+    return std::nullopt;
+  }
+
+  DecodeResult result;
+  result.num_decoded_samples = static_cast<size_t>(total_samples);
+  result.speech_type = speech_type;
+  return result;
+}
+
+}  // namespace webrtc

