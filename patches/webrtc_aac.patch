+
+#include "modules/audio_coding/codecs/aac/aac_platform_decoder.h"
+
+#include "rtc_base/logging.h"
+
+#if defined(WEBRTC_IOS) || defined(WEBRTC_MAC)
+#include "modules/audio_coding/codecs/aac/ios/aac_platform_decoder_ios.h"
+#elif defined(WEBRTC_ANDROID)
+#include "modules/audio_coding/codecs/aac/android/aac_platform_decoder_android.h"
+#endif
+
+namespace webrtc {
+
+#if defined(WEBRTC_ANDROID)
+// Forward declaration of function defined in aac_decoder_factory_android.cc
+extern JavaVM* GetJavaVMForAacDecoder();
+#endif
+
+std::unique_ptr<AacPlatformDecoder> AacPlatformDecoder::Create(
+    const Settings& settings) {
+#if defined(WEBRTC_IOS) || defined(WEBRTC_MAC)
+  // iOS/macOS platform: Use AudioToolbox AudioConverter
+  RTC_LOG(LS_INFO) << "Creating iOS/macOS AAC platform decoder";
+
+  AacPlatformDecoderIOS::Settings ios_settings;
+  ios_settings.sample_rate_hz = settings.sample_rate_hz;
+  ios_settings.num_channels = settings.num_channels;
+  ios_settings.audio_specific_config_hex = settings.audio_specific_config_hex;
+  return AacPlatformDecoderIOS::Create(ios_settings);
+
+#elif defined(WEBRTC_ANDROID)
+  // Android platform: Use MediaCodec
+  RTC_LOG(LS_INFO) << "Creating Android AAC platform decoder";
+
+  // Get JavaVM from factory
+  JavaVM* jvm = GetJavaVMForAacDecoder();
+  if (!jvm) {
+    RTC_LOG(LS_ERROR) << "AacPlatformDecoder::Create: JavaVM not set. "
+                      << "Did you call CreateAacAudioDecoderFactoryAndroid()?";
+    return nullptr;
+  }
+
+  return AacPlatformDecoderAndroid::Create(jvm, settings);
+
+#else
+  RTC_LOG(LS_ERROR) << "AAC decoder not supported on this platform";
+  return nullptr;
+#endif
+}
+
+}  // namespace webrtc

