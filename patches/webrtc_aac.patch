+
+#include "api/audio_codecs/aac/audio_decoder_aac.h"
+
+#include "api/audio_codecs/aac/audio_decoder_aac_impl.h"
+#include "api/audio_codecs/aac/audio_encoder_aac.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+
+std::optional<AudioEncoderAacConfig> AudioDecoderAac::SdpToConfig(
+    const SdpAudioFormat& audio_format) {
+  // Reuse encoder's SDP parsing logic since format is the same
+  return AudioEncoderAac::SdpToConfig(audio_format);
+}
+
+void AudioDecoderAac::AppendSupportedDecoders(
+    std::vector<AudioCodecSpec>* specs) {
+  // Reuse encoder's supported specs since decoder uses same format
+  AudioEncoderAac::AppendSupportedEncoders(specs);
+}
+
+AudioCodecInfo AudioDecoderAac::QueryAudioDecoder(
+    const AudioEncoderAacConfig& config) {
+  // Return decoder capabilities matching encoder
+  return AudioEncoderAac::QueryAudioEncoder(config);
+}
+
+std::unique_ptr<AudioDecoder> AudioDecoderAac::MakeAudioDecoder(
+    const Environment& env,
+    const AudioEncoderAacConfig& config,
+    std::optional<AudioCodecPairId> codec_pair_id) {
+  if (!config.IsOk()) {
+    RTC_LOG(LS_ERROR) << "Invalid AAC decoder config";
+    return nullptr;
+  }
+
+  RTC_LOG(LS_INFO) << "Creating AAC decoder: "
+                   << config.sample_rate_hz << "Hz, "
+                   << config.num_channels << "ch";
+
+  return std::make_unique<AudioDecoderAacImpl>(config);
+}
+
+}  // namespace webrtc

