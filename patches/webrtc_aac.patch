+
+#ifndef MODULES_AUDIO_CODING_CODECS_AAC_IOS_AAC_PLATFORM_DECODER_IOS_H_
+#define MODULES_AUDIO_CODING_CODECS_AAC_IOS_AAC_PLATFORM_DECODER_IOS_H_
+
+#include <AudioToolbox/AudioToolbox.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "api/array_view.h"
+#include "api/sequence_checker.h"
+#include "modules/audio_coding/codecs/aac/aac_platform_decoder.h"
+#include "rtc_base/system/rtc_export.h"
+#include "rtc_base/thread_annotations.h"
+
+namespace webrtc {
+
+// Platform-specific AAC decoder implementation for iOS/macOS using AudioToolbox.
+// Decodes AAC frames to PCM using AudioConverter.
+class RTC_EXPORT AacPlatformDecoderIOS : public AacPlatformDecoder {
+ public:
+  struct Settings {
+    int sample_rate_hz = 48000;
+    size_t num_channels = 2;
+    std::string audio_specific_config_hex;  // e.g., "1190" for AAC-LC 48kHz stereo
+  };
+
+  static std::unique_ptr<AacPlatformDecoderIOS> Create(const Settings& settings);
+
+  ~AacPlatformDecoderIOS() override;
+
+  // Decode AAC frame to PCM samples.
+  // Returns the number of samples decoded per channel, or -1 on error.
+  int Decode(rtc::ArrayView<const uint8_t> aac_data,
+             rtc::ArrayView<int16_t> pcm_out) override;
+
+  void Reset() override;
+
+ private:
+  explicit AacPlatformDecoderIOS(const Settings& settings);
+
+  bool SetupConverter();
+
+  static OSStatus ProvideInputData(AudioConverterRef inAudioConverter,
+                                   UInt32* ioNumberDataPackets,
+                                   AudioBufferList* ioData,
+                                   AudioStreamPacketDescription** outDataPacketDescription,
+                                   void* inUserData);
+
+  Settings settings_;
+  AudioConverterRef converter_ = nullptr;
+
+  // Input buffer for current decode operation
+  std::vector<uint8_t> aac_buffer_;
+
+  // Packet description for VBR format
+  AudioStreamPacketDescription packet_desc_;
+
+  // Sequence checker to ensure thread safety
+  SequenceChecker sequence_checker_;
+};
+
+}  // namespace webrtc
+
+#endif  // MODULES_AUDIO_CODING_CODECS_AAC_IOS_AAC_PLATFORM_DECODER_IOS_H_

diff --git a/modules/audio_coding/codecs/aac/ios/aac_platform_decoder_ios.mm b/modules/audio_coding/codecs/aac/ios/aac_platform_decoder_ios.mm
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/ios/aac_platform_decoder_ios.mm
@@ -0,0 +1,275 @@
+#import "modules/audio_coding/codecs/aac/ios/aac_platform_decoder_ios.h"
+
+#import <AVFoundation/AVFoundation.h>
+
+#include <iomanip>
+#include <sstream>
+
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+
+namespace {
+
+constexpr UInt32 kBitsPerChannel = 16;
+constexpr UInt32 kBytesPerSample = kBitsPerChannel / 8;
+
+std::vector<uint8_t> HexStringToBytes(const std::string& hex) {
+  std::vector<uint8_t> bytes;
+  for (size_t i = 0; i < hex.length(); i += 2) {
+    std::string byte_string = hex.substr(i, 2);
+    uint8_t byte = static_cast<uint8_t>(std::stoi(byte_string, nullptr, 16));
+    bytes.push_back(byte);
+  }
+  return bytes;
+}
+
+// Build ESDS (Elementary Stream Descriptor) from AudioSpecificConfig
+// This is needed for iOS AudioConverter to properly decode AAC
+std::vector<uint8_t> BuildESDS(const std::vector<uint8_t>& asc) {
+  std::vector<uint8_t> esds;
+
+  // ESDS structure:
+  // 0x03 (ES_DescrTag) + length + ESID + flags +
+  // 0x04 (DecoderConfigDescrTag) + length + objectType + streamType + bufferSize + maxBitrate + avgBitrate +
+  // 0x05 (DecSpecificInfoTag) + length + ASC +
+  // 0x06 (SLConfigDescrTag) + length + predefined
+
+  size_t asc_size = asc.size();
+  size_t decoder_specific_info_size = 1 + 1 + asc_size;  // tag + length + ASC
+  size_t decoder_config_size = 1 + 1 + 13 + decoder_specific_info_size;  // tag + length + config + DSI
+  size_t sl_config_size = 1 + 1 + 1;  // tag + length + predefined
+  size_t es_descr_size = 3 + decoder_config_size + sl_config_size;  // ESID + flags + config + SL
+
+  // ES_DescrTag
+  esds.push_back(0x03);
+  esds.push_back(static_cast<uint8_t>(es_descr_size));
+  esds.push_back(0x00);  // ESID (2 bytes)
+  esds.push_back(0x00);
+  esds.push_back(0x00);  // flags
+
+  // DecoderConfigDescrTag
+  esds.push_back(0x04);
+  esds.push_back(static_cast<uint8_t>(13 + decoder_specific_info_size));
+  esds.push_back(0x40);  // objectTypeIndication = MPEG-4 Audio
+  esds.push_back(0x15);  // streamType = Audio (5) << 2 | upstream (0) << 1 | reserved (1)
+  esds.push_back(0x00);  // bufferSizeDB (3 bytes)
+  esds.push_back(0x00);
+  esds.push_back(0x00);
+  esds.push_back(0x00);  // maxBitrate (4 bytes)
+  esds.push_back(0x01);
+  esds.push_back(0xF4);
+  esds.push_back(0x00);
+  esds.push_back(0x00);  // avgBitrate (4 bytes)
+  esds.push_back(0x01);
+  esds.push_back(0xF4);
+  esds.push_back(0x00);
+
+  // DecSpecificInfoTag
+  esds.push_back(0x05);
+  esds.push_back(static_cast<uint8_t>(asc_size));
+  esds.insert(esds.end(), asc.begin(), asc.end());
+
+  // SLConfigDescrTag
+  esds.push_back(0x06);
+  esds.push_back(0x01);
+  esds.push_back(0x02);  // predefined = 2 (reserved for MP4)
+
+  return esds;
+}
+
+}  // namespace
+
+std::unique_ptr<AacPlatformDecoderIOS> AacPlatformDecoderIOS::Create(
+    const Settings& settings) {
+  // Can't use make_unique due to private constructor
+  auto decoder = std::unique_ptr<AacPlatformDecoderIOS>(
+      new AacPlatformDecoderIOS(settings));
+  // Don't call SetupConverter() here - let it be called lazily from Decode()
+  // on the audio processing thread to avoid sequence checker issues
+  return decoder;
+}
+
+AacPlatformDecoderIOS::AacPlatformDecoderIOS(const Settings& settings)
+    : settings_(settings) {
+  sequence_checker_.Detach();
+}
+
+AacPlatformDecoderIOS::~AacPlatformDecoderIOS() {
+  if (converter_) {
+    AudioConverterDispose(converter_);
+    converter_ = nullptr;
+  }
+}
+
+bool AacPlatformDecoderIOS::SetupConverter() {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+
+  // Use raw AAC input with AudioSpecificConfig magic cookie
+  AudioStreamBasicDescription input_format = {0};
+  input_format.mSampleRate = settings_.sample_rate_hz;
+  input_format.mFormatID = kAudioFormatMPEG4AAC;
+  input_format.mChannelsPerFrame = static_cast<UInt32>(settings_.num_channels);
+  input_format.mFramesPerPacket = 1024;  // AAC-LC frame size
+  input_format.mBytesPerPacket = 0;      // Variable bit rate
+
+  AudioStreamBasicDescription output_format = {0};
+  output_format.mSampleRate = settings_.sample_rate_hz;
+  output_format.mFormatID = kAudioFormatLinearPCM;
+  output_format.mFormatFlags = kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked;
+  output_format.mChannelsPerFrame = static_cast<UInt32>(settings_.num_channels);
+  output_format.mBitsPerChannel = kBitsPerChannel;
+  output_format.mBytesPerPacket = kBytesPerSample * output_format.mChannelsPerFrame;
+  output_format.mBytesPerFrame = output_format.mBytesPerPacket;
+  output_format.mFramesPerPacket = 1;
+
+  if (converter_) {
+    AudioConverterDispose(converter_);
+    converter_ = nullptr;
+  }
+
+  OSStatus status = AudioConverterNew(&input_format, &output_format, &converter_);
+  if (status != noErr || !converter_) {
+    RTC_LOG(LS_ERROR) << "AudioConverterNew failed: " << status;
+    return false;
+  }
+
+  // Set AudioSpecificConfig as ESDS magic cookie if provided
+  if (!settings_.audio_specific_config_hex.empty()) {
+    std::vector<uint8_t> asc = HexStringToBytes(settings_.audio_specific_config_hex);
+    std::vector<uint8_t> esds = BuildESDS(asc);
+
+    RTC_LOG(LS_INFO) << "Setting ESDS magic cookie, AudioSpecificConfig hex="
+                     << settings_.audio_specific_config_hex
+                     << ", ASC bytes=" << asc.size()
+                     << ", ESDS bytes=" << esds.size();
+
+    status = AudioConverterSetProperty(
+        converter_,
+        kAudioConverterDecompressionMagicCookie,
+        static_cast<UInt32>(esds.size()),
+        esds.data());
+
+    if (status != noErr) {
+      RTC_LOG(LS_WARNING) << "Failed to set ESDS magic cookie: " << status;
+      // Continue anyway - converter might work without it
+    } else {
+      RTC_LOG(LS_INFO) << "ESDS magic cookie set successfully";
+    }
+  }
+
+  return true;
+}
+
+void AacPlatformDecoderIOS::Reset() {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+  if (converter_) {
+    AudioConverterReset(converter_);
+  }
+}
+
+OSStatus AacPlatformDecoderIOS::ProvideInputData(
+    AudioConverterRef inAudioConverter,
+    UInt32* ioNumberDataPackets,
+    AudioBufferList* ioData,
+    AudioStreamPacketDescription** outDataPacketDescription,
+    void* inUserData) {
+  auto decoder = static_cast<AacPlatformDecoderIOS*>(inUserData);
+
+  ioData->mNumberBuffers = 1;
+  ioData->mBuffers[0].mNumberChannels = static_cast<UInt32>(decoder->settings_.num_channels);
+  ioData->mBuffers[0].mDataByteSize = static_cast<UInt32>(decoder->aac_buffer_.size());
+  ioData->mBuffers[0].mData = decoder->aac_buffer_.data();
+
+  *ioNumberDataPackets = 1;
+
+  // Provide packet description for VBR format
+  if (outDataPacketDescription) {
+    decoder->packet_desc_.mStartOffset = 0;
+    decoder->packet_desc_.mVariableFramesInPacket = 0;
+    decoder->packet_desc_.mDataByteSize = static_cast<UInt32>(decoder->aac_buffer_.size());
+    *outDataPacketDescription = &decoder->packet_desc_;
+  }
+
+  return noErr;
+}
+
+int AacPlatformDecoderIOS::Decode(rtc::ArrayView<const uint8_t> aac_data,
+                                   rtc::ArrayView<int16_t> pcm_out) {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+
+  static int decode_count = 0;
+  decode_count++;
+
+  if (decode_count <= 5 || decode_count % 100 == 0) {
+    RTC_LOG(LS_INFO) << "AAC Decode #" << decode_count
+                     << ": input=" << aac_data.size()
+                     << " bytes, output_buffer=" << pcm_out.size() << " samples";
+  }
+
+  if (!converter_) {
+    RTC_LOG(LS_INFO) << "Setting up AudioConverter (first decode)";
+    if (!SetupConverter()) {
+      return -1;
+    }
+  }
+
+  if (aac_data.empty()) {
+    RTC_LOG(LS_WARNING) << "Empty AAC data";
+    return -1;
+  }
+
+  // Use raw AAC data directly (no ADTS headers)
+  aac_buffer_.assign(aac_data.begin(), aac_data.end());
+
+  // Log first few bytes of AAC data for debugging
+  if (decode_count <= 3) {
+    std::ostringstream hex_dump;
+    size_t dump_size = std::min(aac_data.size(), size_t(16));
+    for (size_t i = 0; i < dump_size; i++) {
+      hex_dump << std::hex << std::setfill('0') << std::setw(2)
+               << static_cast<int>(aac_data[i]) << " ";
+    }
+    RTC_LOG(LS_INFO) << "AAC data first " << dump_size << " bytes: " << hex_dump.str();
+  }
+
+  // Prepare output buffer
+  // For PCM output, packet size = number of frames we want
+  // AAC-LC produces 1024 samples per channel per frame
+  UInt32 io_output_data_packet_size = 1024;
+  AudioBufferList output_buffer;
+  output_buffer.mNumberBuffers = 1;
+  output_buffer.mBuffers[0].mNumberChannels = static_cast<UInt32>(settings_.num_channels);
+  output_buffer.mBuffers[0].mDataByteSize = static_cast<UInt32>(pcm_out.size() * sizeof(int16_t));
+  output_buffer.mBuffers[0].mData = pcm_out.data();
+
+  OSStatus status = AudioConverterFillComplexBuffer(
+      converter_,
+      &AacPlatformDecoderIOS::ProvideInputData,
+      this,
+      &io_output_data_packet_size,
+      &output_buffer,
+      nullptr);
+
+  if (status != noErr || io_output_data_packet_size == 0) {
+    RTC_LOG(LS_ERROR) << "AudioConverterFillComplexBuffer failed: status=" << status
+                      << ", packets=" << io_output_data_packet_size;
+    return -1;
+  }
+
+  // Calculate number of samples per channel
+  size_t bytes_decoded = output_buffer.mBuffers[0].mDataByteSize;
+  size_t samples_per_channel = bytes_decoded / (kBytesPerSample * settings_.num_channels);
+
+  if (decode_count <= 5) {
+    RTC_LOG(LS_INFO) << "Decode #" << decode_count << " SUCCESS: "
+                     << "bytes_decoded=" << bytes_decoded
+                     << ", samples_per_channel=" << samples_per_channel
+                     << ", packets=" << io_output_data_packet_size;
+  }
+
+  return static_cast<int>(samples_per_channel);
+}
+
+}  // namespace webrtc

