+#import "modules/audio_coding/codecs/aac/ios/aac_decoder_factory_ios.h"
+
+#include "api/audio_codecs/audio_decoder_factory_template.h"
+#include "api/audio_codecs/aac/audio_decoder_aac.h"
+#include "api/audio_codecs/opus/audio_decoder_opus.h"
+#include "api/audio_codecs/g711/audio_decoder_g711.h"
+#include "api/audio_codecs/g722/audio_decoder_g722.h"
+#include <vector>
+
+namespace webrtc {
+
+rtc::scoped_refptr<AudioDecoderFactory> CreateAacAudioDecoderFactoryIOS() {
+  // Force linker to include AAC decoder symbols
+  std::vector<AudioCodecSpec> force_link_aac;
+  AudioDecoderAac::AppendSupportedDecoders(&force_link_aac);
+
+  // Create combined factory with AAC (stub) + builtin codecs (Opus, G711, G722)
+  // AAC decoder is stub for SDP negotiation only, actual decoding not needed for sendonly
+  return CreateAudioDecoderFactory<
+      AudioDecoderAac,     // AAC-LC codec (stub for SDP)
+      AudioDecoderOpus,    // Opus codec
+      AudioDecoderG722,    // G.722 codec
+      AudioDecoderG711>();  // G.711 (PCMU/PCMA) codec
+}
+
+// Explicit template instantiation to force generation of AAC decoder factory code
+namespace audio_decoder_factory_template_impl {
+template struct Helper<AudioDecoderAac, AudioDecoderOpus, AudioDecoderG722, AudioDecoderG711>;
+}
+
+}  // namespace webrtc

