diff --git a/modules/audio_coding/codecs/aac/rtp_packetizer_aac.cc b/modules/audio_coding/codecs/aac/rtp_packetizer_aac.cc
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/rtp_packetizer_aac.cc
@@ -0,0 +1,31 @@
+#include "modules/audio_coding/codecs/aac/rtp_packetizer_aac.h"
+
+#include <cstring>
+
+#include "rtc_base/checks.h"
+
+namespace webrtc {
+
+rtc::Buffer RtpPacketizerAac::BuildSingleAuPacket(
+    rtc::ArrayView<const uint8_t> frame) {
+  RTC_DCHECK_LT(frame.size(), (1u << kAuSizeFieldBits));
+  rtc::Buffer packet;
+  packet.SetSize(kAuHeaderLengthBytes + frame.size());
+  uint8_t* dst = packet.data();
+
+  constexpr uint16_t kAuHeadersLengthBits = 16;  // single AU header
+  dst[0] = static_cast<uint8_t>((kAuHeadersLengthBits >> 8) & 0xFF);
+  dst[1] = static_cast<uint8_t>(kAuHeadersLengthBits & 0xFF);
+
+  uint16_t au_header = static_cast<uint16_t>(frame.size() << 3);  // AU-index=0
+  dst[2] = static_cast<uint8_t>((au_header >> 8) & 0xFF);
+  dst[3] = static_cast<uint8_t>(au_header & 0xFF);
+
+  if (!frame.empty()) {
+    std::memcpy(dst + kAuHeaderLengthBytes, frame.data(), frame.size());
+  }
+  return packet;
+}
+
+}  // namespace webrtc
+

