@@ -0,0 +1,61 @@
+#include "modules/audio_coding/codecs/aac/android/aac_decoder_factory_android.h"
+
+#include <jni.h>
+#include <memory>
+#include <vector>
+
+#include "api/audio_codecs/audio_decoder_factory_template.h"
+#include "api/audio_codecs/aac/audio_decoder_aac.h"
+#include "api/audio_codecs/opus/audio_decoder_opus.h"
+#include "api/audio_codecs/g711/audio_decoder_g711.h"
+#include "api/audio_codecs/g722/audio_decoder_g722.h"
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+
+namespace {
+
+// Global JavaVM pointer for AAC decoder creation
+// This is set by CreateAacAudioDecoderFactoryAndroid() and used by
+// CreateAacPlatformDecoder() to create Android platform decoders
+JavaVM* g_decoder_jvm = nullptr;
+
+}  // namespace
+
+// Called by CreateAacPlatformDecoder() to get JavaVM for Android platform
+JavaVM* GetJavaVMForAacDecoder() {
+  return g_decoder_jvm;
+}
+
+rtc::scoped_refptr<AudioDecoderFactory> CreateAacAudioDecoderFactoryAndroid(JavaVM* jvm) {
+  if (!jvm) {
+    RTC_LOG(LS_ERROR) << "CreateAacAudioDecoderFactoryAndroid: jvm is null";
+    return nullptr;
+  }
+
+  // Store JavaVM globally for use by CreateAacPlatformDecoder()
+  g_decoder_jvm = jvm;
+  RTC_LOG(LS_INFO) << "CreateAacAudioDecoderFactoryAndroid: JavaVM stored at " << jvm;
+
+  // Force linker to include AAC symbols by actually calling AppendSupportedDecoders
+  // This creates a hard reference that linker cannot eliminate
+  std::vector<AudioCodecSpec> force_link_aac;
+  AudioDecoderAac::AppendSupportedDecoders(&force_link_aac);
+
+  // Create combined factory with AAC + builtin codecs (Opus, G711, G722)
+  return CreateAudioDecoderFactory<
+      AudioDecoderAac,     // AAC-LC codec (Android MediaCodec)
+      AudioDecoderOpus,    // Opus codec
+      AudioDecoderG722,    // G.722 codec
+      AudioDecoderG711>(); // G.711 (PCMU/PCMA) codec
+}
+
+// Explicit template instantiation to force generation of AAC decoder factory code
+// This ensures the template is instantiated even if the linker thinks it's unused
+namespace audio_decoder_factory_template_impl {
+template struct Helper<AudioDecoderAac, AudioDecoderOpus, AudioDecoderG722, AudioDecoderG711>;
+}
+
+}  // namespace webrtc
+

