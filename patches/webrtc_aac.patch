+#pragma once
+
+#include <AudioToolbox/AudioToolbox.h>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "api/array_view.h"
+#include "api/sequence_checker.h"
+#include "modules/audio_coding/codecs/aac/platform/aac_platform_encoder.h"
+
+namespace webrtc {
+
+class AacPlatformEncoderIOS final : public AacPlatformEncoder {
+ public:
+  struct Settings {
+    int sample_rate_hz = 48000;
+    size_t num_channels = 2;
+    int bitrate_bps = 128000;
+  };
+
+  static std::unique_ptr<AacPlatformEncoderIOS> Create(const Settings& settings);
+
+  explicit AacPlatformEncoderIOS(const Settings& settings);
+  ~AacPlatformEncoderIOS() override;
+
+  EncodedFrame Encode(rtc::ArrayView<const int16_t> pcm,
+                      size_t channels,
+                      int sample_rate_hz) override;
+  void Reset() override;
+  void SetBitrate(int bitrate_bps) override;
+  const std::string& audio_specific_config_hex() const override;
+
+ private:
+  bool SetupConverter();
+  bool EnsureBufferCapacity(size_t pcm_samples);
+  static OSStatus FillInputData(AudioConverterRef inAudioConverter,
+                                UInt32* ioNumberDataPackets,
+                                AudioBufferList* ioData,
+                                AudioStreamPacketDescription** outDataPacketDescription,
+                                void* inUserData);
+
+  Settings settings_;
+  AudioConverterRef converter_ = nullptr;
+  std::vector<int16_t> pcm_buffer_;
+  std::vector<uint8_t> aac_buffer_;
+  std::vector<uint8_t> payload_buffer_;
+  std::string audio_specific_config_hex_;
+  webrtc::SequenceChecker sequence_checker_;
+};
+
+}  // namespace webrtc

diff --git a/modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios.mm b/modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios.mm
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios.mm
@@ -0,0 +1,237 @@
+#import "modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios.h"
+
+#import <AVFoundation/AVFoundation.h>
+
+#include <iomanip>
+#include <sstream>
+
+#include "api/audio_codecs/aac/audio_encoder_aac_config.h"
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+
+namespace {
+constexpr UInt32 kBitsPerChannel = 16;
+constexpr UInt32 kBytesPerSample = kBitsPerChannel / 8;
+constexpr UInt32 kMaxPcmBufferFrames = 2048;  // safeguard
+
+int SampleRateToIndex(int sample_rate_hz) {
+  switch (sample_rate_hz) {
+    case 96000: return 0;
+    case 88200: return 1;
+    case 64000: return 2;
+    case 48000: return 3;
+    case 44100: return 4;
+    case 32000: return 5;
+    case 24000: return 6;
+    case 22050: return 7;
+    case 16000: return 8;
+    case 12000: return 9;
+    case 11025: return 10;
+    case 8000: return 11;
+    default: return 3;  // default 48kHz
+  }
+}
+
+std::string ToHexString(const uint8_t* data, size_t size) {
+  std::ostringstream oss;
+  oss << std::hex << std::setfill('0');
+  for (size_t i = 0; i < size; ++i) {
+    oss << std::setw(2) << static_cast<int>(data[i]);
+  }
+  return oss.str();
+}
+
+}  // namespace
+
+std::unique_ptr<AacPlatformEncoderIOS> AacPlatformEncoderIOS::Create(
+    const Settings& settings) {
+  auto encoder = std::make_unique<AacPlatformEncoderIOS>(settings);
+  // Don't call SetupConverter() here - let it be called lazily from Encode()
+  // on the audio processing thread to avoid sequence checker issues
+  return encoder;
+}
+
+AacPlatformEncoderIOS::AacPlatformEncoderIOS(const Settings& settings)
+    : settings_(settings) {
+  sequence_checker_.Detach();
+}
+
+AacPlatformEncoderIOS::~AacPlatformEncoderIOS() {
+  if (converter_) {
+    AudioConverterDispose(converter_);
+    converter_ = nullptr;
+  }
+}
+
+bool AacPlatformEncoderIOS::SetupConverter() {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+
+  AudioStreamBasicDescription input_format = {0};
+  input_format.mSampleRate = settings_.sample_rate_hz;
+  input_format.mFormatID = kAudioFormatLinearPCM;
+  input_format.mFormatFlags = kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked;
+  input_format.mChannelsPerFrame = static_cast<UInt32>(settings_.num_channels);
+  input_format.mBitsPerChannel = kBitsPerChannel;
+  input_format.mBytesPerPacket = kBytesPerSample * input_format.mChannelsPerFrame;
+  input_format.mBytesPerFrame = input_format.mBytesPerPacket;
+  input_format.mFramesPerPacket = 1;
+
+  AudioStreamBasicDescription output_format = {0};
+  output_format.mSampleRate = settings_.sample_rate_hz;
+  output_format.mFormatID = kAudioFormatMPEG4AAC;
+  output_format.mChannelsPerFrame = input_format.mChannelsPerFrame;
+  output_format.mFramesPerPacket = 1024;
+
+  if (converter_) {
+    AudioConverterDispose(converter_);
+    converter_ = nullptr;
+  }
+
+  OSStatus status = AudioConverterNew(&input_format, &output_format, &converter_);
+  if (status != noErr || !converter_) {
+    RTC_LOG(LS_ERROR) << "AudioConverterNew failed: " << status;
+    return false;
+  }
+
+  UInt32 bitrate = static_cast<UInt32>(settings_.bitrate_bps);
+  status = AudioConverterSetProperty(converter_, kAudioConverterEncodeBitRate,
+                                     sizeof(bitrate), &bitrate);
+  if (status != noErr) {
+    RTC_LOG(LS_WARNING) << "Failed to set AAC bitrate: " << status;
+  }
+
+  // Fetch AudioSpecificConfig (magic cookie)
+  UInt32 config_size = 0;
+  status = AudioConverterGetPropertyInfo(converter_, kAudioConverterCompressionMagicCookie,
+                                          &config_size, nullptr);
+  if (status == noErr && config_size > 0) {
+    std::vector<uint8_t> cookie(config_size);
+    status = AudioConverterGetProperty(converter_, kAudioConverterCompressionMagicCookie,
+                                       &config_size, cookie.data());
+    if (status == noErr) {
+      audio_specific_config_hex_ = ToHexString(cookie.data(), cookie.size());
+    }
+  }
+  if (audio_specific_config_hex_.empty()) {
+    // Fallback to manual AudioSpecificConfig (2 bytes)
+    int audio_object_type = kAacAudioObjectTypeLc;  // AAC-LC
+    int sampling_index = SampleRateToIndex(settings_.sample_rate_hz);
+    int channel_config = static_cast<int>(settings_.num_channels);
+    uint16_t config = static_cast<uint16_t>((audio_object_type & 0x1F)
+                                           << kAacAudioObjectTypeShift);
+    config |= static_cast<uint16_t>((sampling_index & 0x0F)
+                                    << kAacSamplingFreqIndexShift);
+    config |= static_cast<uint16_t>((channel_config & 0x0F)
+                                    << kAacChannelConfigShift);
+    uint8_t asc[2];
+    asc[0] = static_cast<uint8_t>((config >> 8) & 0xFF);
+    asc[1] = static_cast<uint8_t>(config & 0xFF);
+    audio_specific_config_hex_ = ToHexString(asc, 2);
+  }
+
+  return true;
+}
+
+void AacPlatformEncoderIOS::Reset() {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+  if (converter_) {
+    AudioConverterReset(converter_);
+  }
+}
+
+void AacPlatformEncoderIOS::SetBitrate(int bitrate_bps) {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+  settings_.bitrate_bps = bitrate_bps;
+  if (!converter_) {
+    return;
+  }
+  UInt32 bitrate = static_cast<UInt32>(bitrate_bps);
+  AudioConverterSetProperty(converter_, kAudioConverterEncodeBitRate,
+                            sizeof(bitrate), &bitrate);
+}
+
+bool AacPlatformEncoderIOS::EnsureBufferCapacity(size_t pcm_samples) {
+  const size_t pcm_frames = pcm_samples / settings_.num_channels;
+  if (pcm_frames > kMaxPcmBufferFrames) {
+    RTC_LOG(LS_ERROR) << "PCM frame count exceeds safety limit";
+    return false;
+  }
+  if (aac_buffer_.size() < 8192) {
+    aac_buffer_.resize(8192);
+  }
+  payload_buffer_.resize(0);
+  return true;
+}
+
+OSStatus AacPlatformEncoderIOS::FillInputData(AudioConverterRef inAudioConverter,
+                                              UInt32* ioNumberDataPackets,
+                                              AudioBufferList* ioData,
+                                              AudioStreamPacketDescription** outDataPacketDescription,
+                                              void* inUserData) {
+  auto encoder = static_cast<AacPlatformEncoderIOS*>(inUserData);
+  // Input PCM is already provided by the caller; nothing to copy.
+  ioData->mNumberBuffers = 1;
+  ioData->mBuffers[0].mNumberChannels = static_cast<UInt32>(encoder->settings_.num_channels);
+  ioData->mBuffers[0].mDataByteSize =
+      static_cast<UInt32>(encoder->pcm_buffer_.size() * sizeof(int16_t));
+  ioData->mBuffers[0].mData = encoder->pcm_buffer_.data();
+  *ioNumberDataPackets = 1;
+  return noErr;
+}
+
+AacPlatformEncoder::EncodedFrame AacPlatformEncoderIOS::Encode(
+    rtc::ArrayView<const int16_t> pcm,
+    size_t channels,
+    int sample_rate_hz) {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+  EncodedFrame frame;
+  if (!converter_) {
+    if (!SetupConverter()) {
+      return frame;
+    }
+  }
+  if (channels != settings_.num_channels || sample_rate_hz != settings_.sample_rate_hz) {
+    settings_.num_channels = channels;
+    settings_.sample_rate_hz = sample_rate_hz;
+    if (!SetupConverter()) {
+      return frame;
+    }
+  }
+  if (!EnsureBufferCapacity(pcm.size())) {
+    return frame;
+  }
+  pcm_buffer_.assign(pcm.begin(), pcm.end());
+  UInt32 io_output_packets = 1;
+  AudioBufferList output_buffer;
+  output_buffer.mNumberBuffers = 1;
+  output_buffer.mBuffers[0].mNumberChannels = static_cast<UInt32>(settings_.num_channels);
+  output_buffer.mBuffers[0].mDataByteSize = static_cast<UInt32>(aac_buffer_.size());
+  output_buffer.mBuffers[0].mData = aac_buffer_.data();
+
+  OSStatus status = AudioConverterFillComplexBuffer(
+      converter_, &AacPlatformEncoderIOS::FillInputData, this, &io_output_packets,
+      &output_buffer, nullptr);
+  if (status != noErr || io_output_packets == 0) {
+    RTC_LOG(LS_ERROR) << "AudioConverterFillComplexBuffer failed: " << status;
+    return frame;
+  }
+
+  size_t aac_bytes = output_buffer.mBuffers[0].mDataByteSize;
+  uint8_t* encoded_data = static_cast<uint8_t*>(output_buffer.mBuffers[0].mData);
+
+  // Strip ADTS if present
+  if (aac_bytes >= 7 && (encoded_data[0] == 0xFF) &&
+      ((encoded_data[1] & 0xF0) == 0xF0)) {
+    encoded_data += 7;
+    aac_bytes -= 7;
+  }
+
+  frame.success = true;
+  frame.aac_data.assign(encoded_data, encoded_data + aac_bytes);
+  return frame;
+}
+
+const std::string& AacPlatformEncoderIOS::audio_specific_config_hex() const {
+  return audio_specific_config_hex_;
+}
+
+}  // namespace webrtc

diff --git a/modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios_unittest.mm b/modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios_unittest.mm
