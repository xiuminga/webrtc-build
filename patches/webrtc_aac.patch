diff --git a/modules/audio_coding/codecs/aac/platform/aac_platform_encoder_factory.cc b/modules/audio_coding/codecs/aac/platform/aac_platform_encoder_factory.cc
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/platform/aac_platform_encoder_factory.cc
@@ -0,0 +1,61 @@
+#include "modules/audio_coding/codecs/aac/platform/aac_platform_encoder.h"
+
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+#if defined(WEBRTC_IOS) || defined(WEBRTC_MAC)
+#include "modules/audio_coding/codecs/aac/ios/aac_platform_encoder_ios.h"
+#elif defined(WEBRTC_ANDROID)
+#include "modules/audio_coding/codecs/aac/android/aac_platform_encoder_android.h"
+#endif
+
+namespace webrtc {
+
+#if defined(WEBRTC_ANDROID)
+// Forward declaration of function defined in aac_encoder_factory_android.cc
+// This function returns the JavaVM pointer set by CreateAacAudioEncoderFactoryAndroid()
+extern JavaVM* GetJavaVMForAacEncoder();
+#endif
+
+std::unique_ptr<AacPlatformEncoder> CreateAacPlatformEncoder(
+    const AudioEncoderAacConfig& config) {
+  
+#if defined(WEBRTC_IOS) || defined(WEBRTC_MAC)
+  // iOS/macOS platform: Use AudioToolbox AudioConverter
+  RTC_LOG(LS_INFO) << "Creating iOS/macOS AAC platform encoder";
+  
+  AacPlatformEncoderIOS::Settings settings;
+  settings.sample_rate_hz = config.sample_rate_hz;
+  settings.num_channels = config.num_channels;
+  settings.bitrate_bps = config.bitrate_bps;
+  
+  return AacPlatformEncoderIOS::Create(settings);
+  
+#elif defined(WEBRTC_ANDROID)
+  // Android platform: Use MediaCodec
+  RTC_LOG(LS_INFO) << "Creating Android AAC platform encoder";
+  
+  // Get JavaVM from factory
+  JavaVM* jvm = GetJavaVMForAacEncoder();
+  if (!jvm) {
+    RTC_LOG(LS_ERROR) << "CreateAacPlatformEncoder: JavaVM not set. "
+                      << "Did you call CreateAacAudioEncoderFactoryAndroid()?";
+    return nullptr;
+  }
+  
+  AacPlatformEncoderAndroid::Settings settings;
+  settings.sample_rate_hz = config.sample_rate_hz;
+  settings.num_channels = config.num_channels;
+  settings.bitrate_bps = config.bitrate_bps;
+  
+  return AacPlatformEncoderAndroid::Create(jvm, settings);
+  
+#else
+  // Unsupported platform
+  RTC_LOG(LS_ERROR) << "CreateAacPlatformEncoder: Unsupported platform";
+  return nullptr;
+#endif
+}
+
+}  // namespace webrtc
+

diff --git a/modules/audio_coding/codecs/aac/ios/README.md b/modules/audio_coding/codecs/aac/ios/README.md
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/ios/README.md
@@ -0,0 +1,29 @@
+# iOS WebRTC + AAC 集成指南
+
+1. 将 `webrtc_aac` 目录内容引入 WebRTC iOS 构建工程，修改 GN/BUILD 文件包含新增源码。
+2. 在应用中替换 `RTCPeerConnectionFactory` 初始化：
+   ```objc
+   NSError *error = nil;
+   RTCPeerConnectionFactory *factory = [RTCAACPeerConnectionFactory createFactoryWithOptions:nil error:&error];
+   ```
+3. 创建音频轨时设置 codec preference：
+   ```objc
+   RTCRtpSender *sender = [peerConnection addTrack:audioTrack streamIds:@[@"audio"]];
+   NSMutableArray<RTCRtpCodecParameters *> *codecs = [sender.parameters.codecs mutableCopy];
+   [codecs sortUsingComparator:^NSComparisonResult(RTCRtpCodecParameters * _Nonnull obj1, RTCRtpCodecParameters * _Nonnull obj2) {
+     if ([obj1.name caseInsensitiveCompare:@"mpeg4-generic"] == NSOrderedSame) {
+       return NSOrderedAscending;
+     }
+     if ([obj2.name caseInsensitiveCompare:@"mpeg4-generic"] == NSOrderedSame) {
+       return NSOrderedDescending;
+     }
+     return NSOrderedSame;
+   }];
+   RTCRtpParameters *params = sender.parameters;
+   params.codecs = codecs;
+   [sender setParameters:params error:nil];
+   ```
+4. 创建 Offer 后检查 SDP 中包含 `a=rtpmap:97 mpeg4-generic/48000/2`，否则记录错误退出。
+5. 监听 `AVAudioSessionInterruptionNotification`，在中断结束时调用 `webrtc::AacPlatformEncoderIOS::Reset()` 触发 AudioConverter 重建。
+6. 使用 `ffmpeg` + Wireshark 脚本验证推流 RTP Payload Type 和 AU Header。
+

