+#pragma once
+
+#include <jni.h>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "api/array_view.h"
+#include "api/sequence_checker.h"
+#include "modules/audio_coding/codecs/aac/platform/aac_platform_encoder.h"
+#include "rtc_base/synchronization/mutex.h"
+
+namespace webrtc {
+
+// JNI helper class for thread-safe JNI operations
+// CRITICAL: Each encoding thread MUST call AttachCurrentThread()
+// NEVER cache JNIEnv* across threads
+class JniHelper {
+ public:
+  explicit JniHelper(JavaVM* jvm);
+  ~JniHelper();
+
+  // Attach current thread to JVM if not already attached
+  // Returns JNIEnv* for current thread
+  JNIEnv* AttachCurrentThread();
+
+  // Detach current thread from JVM if it was attached by this helper
+  void DetachIfNeeded();
+
+ private:
+  JavaVM* jvm_;
+  bool attached_ = false;
+};
+
+// Android platform AAC encoder using MediaCodec
+// Implements AAC-LC encoding via Android's hardware/software codec
+class AacPlatformEncoderAndroid final : public AacPlatformEncoder {
+ public:
+  struct Settings {
+    int sample_rate_hz = 48000;
+    size_t num_channels = 2;
+    int bitrate_bps = 128000;
+  };
+
+  // Factory method to create encoder instance
+  // Returns nullptr if MediaCodec initialization fails
+  static std::unique_ptr<AacPlatformEncoderAndroid> Create(
+      JavaVM* jvm,
+      const Settings& settings);
+
+  explicit AacPlatformEncoderAndroid(JavaVM* jvm, const Settings& settings);
+  ~AacPlatformEncoderAndroid() override;
+
+  // AacPlatformEncoder interface implementation
+  EncodedFrame Encode(rtc::ArrayView<const int16_t> pcm,
+                      size_t channels,
+                      int sample_rate_hz) override;
+  void Reset() override;
+  void SetBitrate(int bitrate_bps) override;
+  const std::string& audio_specific_config_hex() const override;
+
+ private:
+  // Initialize MediaCodec encoder
+  // Returns true on success, false on failure
+  bool InitializeMediaCodec();
+
+  // Release MediaCodec resources
+  void ReleaseMediaCodec();
+
+  // Generate AudioSpecificConfig ("1190" for AAC-LC 48kHz stereo)
+  // Called after MediaCodec initialization
+  void GenerateAudioSpecificConfig();
+
+  // Encode PCM samples to AAC using MediaCodec
+  // CRITICAL: PTS must be in microseconds, NOT RTP timestamp or nanoseconds
+  // pts_us = (samples_sent_ * 1'000'000LL) / sample_rate_hz_
+  bool EncodeInternal(const int16_t* pcm_data,
+                      size_t num_samples,
+                      std::vector<uint8_t>* aac_output);
+
+  // Calculate presentation timestamp in microseconds
+  // CRITICAL: Must use microseconds for MediaCodec
+  int64_t CalculatePtsUs(size_t num_samples);
+
+  Settings settings_;
+  std::unique_ptr<JniHelper> jni_helper_;
+
+  // MediaCodec JNI references
+  jobject media_codec_ = nullptr;           // MediaCodec instance
+  jobject input_buffers_ = nullptr;         // Input ByteBuffer array
+  jobject output_buffers_ = nullptr;        // Output ByteBuffer array
+  jobject buffer_info_ = nullptr;           // MediaCodec.BufferInfo
+
+  // JNI method IDs (cached for performance)
+  jmethodID dequeue_input_buffer_method_ = nullptr;
+  jmethodID queue_input_buffer_method_ = nullptr;
+  jmethodID dequeue_output_buffer_method_ = nullptr;
+  jmethodID release_output_buffer_method_ = nullptr;
+  jmethodID get_output_format_method_ = nullptr;
+
+  // Encoding state
+  int64_t samples_sent_ = 0;                // Cumulative sample counter for PTS
+  std::string audio_specific_config_hex_;   // "1190" for AAC-LC 48kHz stereo
+  std::vector<uint8_t> aac_buffer_;         // Temporary buffer for AAC output
+
+  // Thread safety
+  webrtc::Mutex mutex_;
+  webrtc::SequenceChecker sequence_checker_;
+};
+
+}  // namespace webrtc
+

