+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#ifndef API_AUDIO_CODECS_AAC_AUDIO_ENCODER_AAC_CONFIG_H_
+#define API_AUDIO_CODECS_AAC_AUDIO_ENCODER_AAC_CONFIG_H_
+
+#include <optional>
+#include <string>
+
+namespace webrtc {
+
+inline constexpr char kAacDefaultAudioSpecificConfigHex[] = "1190";
+inline constexpr int kAacAudioObjectTypeLc = 2;
+inline constexpr int kAacAudioObjectTypeShift = 11;
+inline constexpr int kAacSamplingFreqIndexShift = 7;
+inline constexpr int kAacChannelConfigShift = 3;
+
+struct AudioEncoderAacConfig {
+  bool IsOk() const {
+    return (sample_rate_hz == 48000 || sample_rate_hz == 44100 || 
+            sample_rate_hz == 32000 || sample_rate_hz == 24000 ||
+            sample_rate_hz == 16000 || sample_rate_hz == 8000) &&
+           (num_channels >= 1 && num_channels <= 2) &&
+           (bitrate_bps >= 32000 && bitrate_bps <= 256000);
+  }
+  
+  int sample_rate_hz = 48000;
+  int num_channels = 2;
+  int bitrate_bps = 128000;
+  std::string audio_specific_config_hex = kAacDefaultAudioSpecificConfigHex;
+};
+
+}  // namespace webrtc
+
+#endif  // API_AUDIO_CODECS_AAC_AUDIO_ENCODER_AAC_CONFIG_H_

diff --git a/modules/audio_coding/codecs/aac/BUILD.gn b/modules/audio_coding/codecs/aac/BUILD.gn
