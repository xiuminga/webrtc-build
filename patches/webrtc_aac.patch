+#ifndef MODULES_AUDIO_CODING_CODECS_AAC_AAC_PLATFORM_DECODER_H_
+#define MODULES_AUDIO_CODING_CODECS_AAC_AAC_PLATFORM_DECODER_H_
+
+#include <memory>
+#include <string>
+
+#include "api/array_view.h"
+
+namespace webrtc {
+
+// Abstract platform decoder interface for AAC.
+// Platform-specific implementations (iOS, Android) implement this interface.
+class AacPlatformDecoder {
+ public:
+  struct Settings {
+    int sample_rate_hz = 48000;
+    size_t num_channels = 2;
+    std::string audio_specific_config_hex;  // e.g., "1190" for AAC-LC 48kHz stereo
+  };
+
+  virtual ~AacPlatformDecoder() = default;
+
+  static std::unique_ptr<AacPlatformDecoder> Create(const Settings& settings);
+
+  // Decode AAC frame to PCM samples.
+  // Returns the number of samples decoded per channel, or -1 on error.
+  virtual int Decode(rtc::ArrayView<const uint8_t> aac_data,
+                     rtc::ArrayView<int16_t> pcm_out) = 0;
+
+  virtual void Reset() = 0;
+};
+
+}  // namespace webrtc
+
+#endif  // MODULES_AUDIO_CODING_CODECS_AAC_AAC_PLATFORM_DECODER_H_

