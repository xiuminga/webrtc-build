+#pragma once
+
+#include <jni.h>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "api/array_view.h"
+#include "api/sequence_checker.h"
+#include "modules/audio_coding/codecs/aac/aac_platform_decoder.h"
+#include "rtc_base/synchronization/mutex.h"
+
+namespace webrtc {
+
+// Forward declaration of JniHelper (defined in aac_platform_encoder_android.h)
+class JniHelper;
+
+// Android platform AAC decoder using MediaCodec
+// Implements AAC-LC decoding via Android's hardware/software codec
+class AacPlatformDecoderAndroid final : public AacPlatformDecoder {
+ public:
+  // Factory method to create decoder instance
+  // Returns nullptr if MediaCodec initialization fails
+  static std::unique_ptr<AacPlatformDecoderAndroid> Create(
+      JavaVM* jvm,
+      const Settings& settings);
+
+  explicit AacPlatformDecoderAndroid(JavaVM* jvm, const Settings& settings);
+  ~AacPlatformDecoderAndroid() override;
+
+  // AacPlatformDecoder interface implementation
+  int Decode(rtc::ArrayView<const uint8_t> aac_data,
+             rtc::ArrayView<int16_t> pcm_out) override;
+  void Reset() override;
+
+ private:
+  // Initialize MediaCodec decoder
+  // Returns true on success, false on failure
+  bool InitializeMediaCodec();
+
+  // Release MediaCodec resources
+  void ReleaseMediaCodec();
+
+  // Parse AudioSpecificConfig hex string to extract sample rate and channels
+  // e.g., "1190" -> 48000 Hz, 2 channels
+  bool ParseAudioSpecificConfig();
+
+  // Decode AAC frame to PCM using MediaCodec
+  bool DecodeInternal(const uint8_t* aac_data,
+                      size_t aac_size,
+                      int16_t* pcm_out,
+                      size_t pcm_capacity,
+                      int* samples_decoded);
+
+  Settings settings_;
+  std::unique_ptr<JniHelper> jni_helper_;
+
+  // MediaCodec JNI references
+  jobject media_codec_ = nullptr;           // MediaCodec instance
+  jobject input_buffers_ = nullptr;         // Input ByteBuffer array
+  jobject output_buffers_ = nullptr;        // Output ByteBuffer array
+  jobject buffer_info_ = nullptr;           // MediaCodec.BufferInfo
+
+  // JNI method IDs (cached for performance)
+  jmethodID dequeue_input_buffer_method_ = nullptr;
+  jmethodID queue_input_buffer_method_ = nullptr;
+  jmethodID dequeue_output_buffer_method_ = nullptr;
+  jmethodID release_output_buffer_method_ = nullptr;
+  jmethodID get_output_format_method_ = nullptr;
+
+  // Decoding state
+  std::vector<int16_t> pcm_buffer_;         // Temporary buffer for PCM output
+
+  // Thread safety
+  webrtc::Mutex mutex_;
+  webrtc::SequenceChecker sequence_checker_;
+};
+
+}  // namespace webrtc
+

diff --git a/modules/audio_coding/codecs/aac/android/aac_platform_encoder_android.cc b/modules/audio_coding/codecs/aac/android/aac_platform_encoder_android.cc
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/android/aac_platform_encoder_android.cc
@@ -0,0 +1,343 @@
+#include "modules/audio_coding/codecs/aac/android/aac_platform_encoder_android.h"
+
+#include <media/NdkMediaCodec.h>
+#include <media/NdkMediaFormat.h>
+#include <android/log.h>
+
+#include "api/audio_codecs/aac/audio_encoder_aac_config.h"
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+#define LOG_TAG "AacPlatformEncoderAndroid"
+#define ALOGD(...) __android_log_print(ANDROID_LOG_DEBUG, LOG_TAG, __VA_ARGS__)
+#define ALOGE(...) __android_log_print(ANDROID_LOG_ERROR, LOG_TAG, __VA_ARGS__)
+
+namespace webrtc {
+
+namespace {
+
+// MediaCodec timeout in microseconds
+constexpr int64_t kTimeoutUs = 10000;  // 10ms
+
+// AAC frame size (samples per frame for AAC-LC)
+constexpr size_t kAacSamplesPerFrame = 1024;
+
+}  // namespace
+
+// ============================================================================
+// JniHelper Implementation
+// ============================================================================
+
+JniHelper::JniHelper(JavaVM* jvm) : jvm_(jvm) {
+  RTC_DCHECK(jvm_);
+}
+
+JniHelper::~JniHelper() {
+  DetachIfNeeded();
+}
+
+JNIEnv* JniHelper::AttachCurrentThread() {
+  RTC_DCHECK(jvm_);
+  JNIEnv* env = nullptr;
+  
+  // Check if current thread is already attached
+  jint result = jvm_->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6);
+  
+  if (result == JNI_EDETACHED) {
+    // Thread not attached, attach it now
+    result = jvm_->AttachCurrentThread(&env, nullptr);
+    if (result != JNI_OK) {
+      ALOGE("Failed to attach current thread to JVM: %d", result);
+      return nullptr;
+    }
+    attached_ = true;
+    ALOGD("Thread attached to JVM");
+  } else if (result != JNI_OK) {
+    ALOGE("Failed to get JNIEnv: %d", result);
+    return nullptr;
+  }
+  
+  return env;
+}
+
+void JniHelper::DetachIfNeeded() {
+  if (attached_ && jvm_) {
+    jvm_->DetachCurrentThread();
+    attached_ = false;
+    ALOGD("Thread detached from JVM");
+  }
+}
+
+// ============================================================================
+// AacPlatformEncoderAndroid Implementation
+// ============================================================================
+
+std::unique_ptr<AacPlatformEncoderAndroid> AacPlatformEncoderAndroid::Create(
+    JavaVM* jvm,
+    const Settings& settings) {
+  auto encoder = std::make_unique<AacPlatformEncoderAndroid>(jvm, settings);
+  if (!encoder->InitializeMediaCodec()) {
+    ALOGE("Failed to initialize MediaCodec");
+    return nullptr;
+  }
+  return encoder;
+}
+
+AacPlatformEncoderAndroid::AacPlatformEncoderAndroid(JavaVM* jvm,
+                                                     const Settings& settings)
+    : settings_(settings),
+      jni_helper_(std::make_unique<JniHelper>(jvm)) {
+  RTC_DCHECK(jni_helper_);
+  ALOGD("AacPlatformEncoderAndroid created: %d Hz, %zu ch, %d bps",
+        settings_.sample_rate_hz, settings_.num_channels, settings_.bitrate_bps);
+}
+
+AacPlatformEncoderAndroid::~AacPlatformEncoderAndroid() {
+  ReleaseMediaCodec();
+  ALOGD("AacPlatformEncoderAndroid destroyed");
+}
+
+bool AacPlatformEncoderAndroid::InitializeMediaCodec() {
+  webrtc::MutexLock lock(&mutex_);
+  
+  ALOGD("Initializing MediaCodec for AAC-LC encoding");
+  
+  // Create MediaFormat for AAC-LC
+  AMediaFormat* format = AMediaFormat_new();
+  if (!format) {
+    ALOGE("Failed to create AMediaFormat");
+    return false;
+  }
+  
+  // Configure AAC-LC format
+  // CRITICAL: Use MIMETYPE_AUDIO_AAC for AAC encoding
+  AMediaFormat_setString(format, AMEDIAFORMAT_KEY_MIME, "audio/mp4a-latm");
+  AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_SAMPLE_RATE, settings_.sample_rate_hz);
+  AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_CHANNEL_COUNT, settings_.num_channels);
+  AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_BIT_RATE, settings_.bitrate_bps);
+  AMediaFormat_setInt32(format, AMEDIAFORMAT_KEY_AAC_PROFILE, 2);  // AAC-LC
+  
+  ALOGD("MediaFormat configured: %d Hz, %zu ch, %d bps, AAC-LC profile",
+        settings_.sample_rate_hz, settings_.num_channels, settings_.bitrate_bps);
+  
+  // Create MediaCodec encoder
+  AMediaCodec* codec = AMediaCodec_createEncoderByType("audio/mp4a-latm");
+  if (!codec) {
+    ALOGE("Failed to create MediaCodec encoder");
+    AMediaFormat_delete(format);
+    return false;
+  }
+  
+  // Configure MediaCodec
+  media_status_t status = AMediaCodec_configure(codec, format, nullptr, nullptr,
+                                                 AMEDIACODEC_CONFIGURE_FLAG_ENCODE);
+  AMediaFormat_delete(format);
+  
+  if (status != AMEDIA_OK) {
+    ALOGE("Failed to configure MediaCodec: %d", status);
+    AMediaCodec_delete(codec);
+    return false;
+  }
+  
+  // Start MediaCodec
+  status = AMediaCodec_start(codec);
+  if (status != AMEDIA_OK) {
+    ALOGE("Failed to start MediaCodec: %d", status);
+    AMediaCodec_delete(codec);
+    return false;
+  }
+  
+  // Store codec reference (cast to jobject for consistency with header)
+  media_codec_ = reinterpret_cast<jobject>(codec);
+  
+  // Generate AudioSpecificConfig
+  GenerateAudioSpecificConfig();
+  
+  ALOGD("MediaCodec initialized and started successfully");
+  return true;
+}
+
+void AacPlatformEncoderAndroid::ReleaseMediaCodec() {
+  webrtc::MutexLock lock(&mutex_);
+  
+  if (media_codec_) {
+    AMediaCodec* codec = reinterpret_cast<AMediaCodec*>(media_codec_);
+    AMediaCodec_stop(codec);
+    AMediaCodec_delete(codec);
+    media_codec_ = nullptr;
+    ALOGD("MediaCodec released");
+  }
+  
+  samples_sent_ = 0;
+}
+
+void AacPlatformEncoderAndroid::GenerateAudioSpecificConfig() {
+  // For AAC-LC 48kHz stereo, AudioSpecificConfig is always "1190"
+  // This matches the iOS implementation
+  audio_specific_config_hex_ = kAacDefaultAudioSpecificConfigHex;
+  ALOGD("AudioSpecificConfig generated: %s", audio_specific_config_hex_.c_str());
+}
+
+AacPlatformEncoder::EncodedFrame AacPlatformEncoderAndroid::Encode(
+    rtc::ArrayView<const int16_t> pcm,
+    size_t channels,
+    int sample_rate_hz) {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+  
+  EncodedFrame result;
+  result.success = false;
+  
+  if (!media_codec_) {
+    ALOGE("MediaCodec not initialized");
+    return result;
+  }
+  
+  if (channels != settings_.num_channels || sample_rate_hz != settings_.sample_rate_hz) {
+    ALOGE("Invalid input parameters: %zu ch, %d Hz (expected %zu ch, %d Hz)",
+          channels, sample_rate_hz, settings_.num_channels, settings_.sample_rate_hz);
+    return result;
+  }
+  
+  // Encode PCM to AAC
+  std::vector<uint8_t> aac_output;
+  if (!EncodeInternal(pcm.data(), pcm.size(), &aac_output)) {
+    ALOGE("EncodeInternal failed");
+    return result;
+  }
+  
+  result.success = true;
+  result.aac_data = std::move(aac_output);
+  
+  return result;
+}
+
+void AacPlatformEncoderAndroid::Reset() {
+  RTC_DCHECK_RUN_ON(&sequence_checker_);
+  ALOGD("Reset called");
+  
+  ReleaseMediaCodec();
+  InitializeMediaCodec();
+}
+
+void AacPlatformEncoderAndroid::SetBitrate(int bitrate_bps) {
+  webrtc::MutexLock lock(&mutex_);
+  
+  if (bitrate_bps == settings_.bitrate_bps) {
+    return;
+  }
+  
+  ALOGD("SetBitrate: %d bps -> %d bps", settings_.bitrate_bps, bitrate_bps);
+  settings_.bitrate_bps = bitrate_bps;
+  
+  // TODO: Update MediaCodec bitrate dynamically using setParameters
+  // For now, require Reset() to apply new bitrate
+}
+
+const std::string& AacPlatformEncoderAndroid::audio_specific_config_hex() const {
+  return audio_specific_config_hex_;
+}
+
+bool AacPlatformEncoderAndroid::EncodeInternal(const int16_t* pcm_data,
+                                                size_t num_samples,
+                                                std::vector<uint8_t>* aac_output) {
+  RTC_DCHECK(pcm_data);
+  RTC_DCHECK(aac_output);
+  RTC_DCHECK(media_codec_);
+  
+  AMediaCodec* codec = reinterpret_cast<AMediaCodec*>(media_codec_);
+  
+  // Get input buffer
+  ssize_t input_index = AMediaCodec_dequeueInputBuffer(codec, kTimeoutUs);
+  if (input_index < 0) {
+    ALOGE("Failed to dequeue input buffer: %zd", input_index);
+    return false;
+  }
+  
+  // Get input buffer pointer
+  size_t input_size = 0;
+  uint8_t* input_buffer = AMediaCodec_getInputBuffer(codec, input_index, &input_size);
+  if (!input_buffer) {
+    ALOGE("Failed to get input buffer");
+    return false;
+  }
+  
+  // Copy PCM data to input buffer
+  size_t pcm_bytes = num_samples * sizeof(int16_t);
+  if (pcm_bytes > input_size) {
+    ALOGE("PCM data too large: %zu > %zu", pcm_bytes, input_size);
+    return false;
+  }
+  
+  memcpy(input_buffer, pcm_data, pcm_bytes);
+  
+  // CRITICAL: Calculate PTS in microseconds
+  // PTS must be in microseconds for MediaCodec, NOT RTP timestamp or nanoseconds
+  int64_t pts_us = CalculatePtsUs(num_samples);
+  
+  // Queue input buffer
+  media_status_t status = AMediaCodec_queueInputBuffer(
+      codec, input_index, 0, pcm_bytes, pts_us, 0);
+  if (status != AMEDIA_OK) {
+    ALOGE("Failed to queue input buffer: %d", status);
+    return false;
+  }
+  
+  // Get output buffer
+  AMediaCodecBufferInfo info;
+  ssize_t output_index = AMediaCodec_dequeueOutputBuffer(codec, &info, kTimeoutUs);
+  
+  if (output_index >= 0) {
+    // Get output buffer pointer
+    size_t output_size = 0;
+    uint8_t* output_buffer = AMediaCodec_getOutputBuffer(codec, output_index, &output_size);
+    
+    if (output_buffer && info.size > 0) {
+      // Copy AAC data to output vector
+      aac_output->assign(output_buffer + info.offset,
+                         output_buffer + info.offset + info.size);
+      
+      ALOGD("Encoded AAC frame: %d bytes, PTS: %lld us",
+            info.size, static_cast<long long>(pts_us));
+    }
+    
+    // Release output buffer
+    AMediaCodec_releaseOutputBuffer(codec, output_index, false);
+    return true;
+    
+  } else if (output_index == AMEDIACODEC_INFO_TRY_AGAIN_LATER) {
+    // No output available yet, this is normal
+    ALOGD("No output available yet (TRY_AGAIN_LATER)");
+    return true;
+    
+  } else if (output_index == AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED) {
+    // Output format changed, log it
+    AMediaFormat* format = AMediaCodec_getOutputFormat(codec);
+    ALOGD("Output format changed");
+    AMediaFormat_delete(format);
+    return true;
+    
+  } else {
+    ALOGE("Unexpected output index: %zd", output_index);
+    return false;
+  }
+}
+
+int64_t AacPlatformEncoderAndroid::CalculatePtsUs(size_t num_samples) {
+  // CRITICAL: PTS must be in microseconds for MediaCodec
+  // Formula: pts_us = (samples_sent * 1'000'000) / sample_rate_hz
+  // Do NOT use RTP timestamp or nanoseconds
+  
+  int64_t pts_us = (samples_sent_ * 1'000'000LL) / settings_.sample_rate_hz;
+  samples_sent_ += num_samples;
+  
+  return pts_us;
+}
+
+}  // namespace webrtc
+

