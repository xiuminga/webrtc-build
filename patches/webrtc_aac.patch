+namespace webrtc {
+
+rtc::scoped_refptr<AudioEncoderFactory> CreateAacAudioEncoderFactoryIOS() {
+  // Force linker to include AAC symbols by actually calling AppendSupportedEncoders
+  // This creates a hard reference that linker cannot eliminate
+  std::vector<AudioCodecSpec> force_link_aac;
