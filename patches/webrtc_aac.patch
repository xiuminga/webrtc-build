diff --git a/modules/audio_coding/codecs/aac/rtp_packetizer_aac_smoketest.cc b/modules/audio_coding/codecs/aac/rtp_packetizer_aac_smoketest.cc
new file mode 100644
index 0000000000..1111111111
--- /dev/null
+++ b/modules/audio_coding/codecs/aac/rtp_packetizer_aac_smoketest.cc
@@ -0,0 +1,28 @@
+#include <iostream>
+
+#include "modules/audio_coding/codecs/aac/rtp_packetizer_aac.h"
+
+int main() {
+  const uint8_t kPayload[] = {0xAA, 0xBB};
+  rtc::Buffer packet = webrtc::RtpPacketizerAac::BuildSingleAuPacket(
+      rtc::MakeArrayView(kPayload, sizeof(kPayload)));
+  if (packet.size() != 6) {
+    std::cerr << "Unexpected packet size: " << packet.size() << std::endl;
+    return 1;
+  }
+  if (packet[0] != 0x00 || packet[1] != 0x10) {
+    std::cerr << "Invalid AU-headers-length" << std::endl;
+    return 1;
+  }
+  // AU-size should be payload length (2) << 3 = 16 -> 0x00 0x10.
+  if (packet[2] != 0x00 || packet[3] != 0x10) {
+    std::cerr << "Invalid AU-size field" << std::endl;
+    return 1;
+  }
+  if (packet[4] != 0xAA || packet[5] != 0xBB) {
+    std::cerr << "Payload mismatch" << std::endl;
+    return 1;
+  }
+  std::cout << "AAC packetizer smoke test passed." << std::endl;
+  return 0;
+}

