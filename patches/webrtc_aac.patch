--- /dev/null
+++ b/modules/audio_coding/codecs/aac/audio_encoder_aac_impl.cc
@@ -0,0 +1,161 @@
+/*
+ *  Copyright (c) 2024 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#include "modules/audio_coding/codecs/aac/audio_encoder_aac_impl.h"
+
+#include <algorithm>
+#include <cstring>
+#include <utility>
+
+#include "api/units/time_delta.h"
+#include "modules/audio_coding/codecs/aac/rtp_packetizer_aac.h"
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+
+namespace {
+constexpr size_t kAacSamplesPerFrame = 1024;  // AAC-LC
+}  // namespace
+
+AudioEncoderAacImpl::AudioEncoderAacImpl(const Environment& env,
+                                         const AudioEncoderAacConfig& config,
+                                         int payload_type)
+    : config_(config),
+      payload_type_(payload_type),
+      platform_encoder_(CreateAacPlatformEncoder(config)),
+      next_rtp_timestamp_(0),
+      target_bitrate_bps_(config.bitrate_bps) {
+  RTC_DCHECK(config_.IsOk());
+  RTC_DCHECK(platform_encoder_);
+  (void)env;  // Currently unused.
+}
+
+AudioEncoderAacImpl::~AudioEncoderAacImpl() = default;
+
+int AudioEncoderAacImpl::SampleRateHz() const {
+  return config_.sample_rate_hz;
+}
+
+size_t AudioEncoderAacImpl::NumChannels() const {
+  return config_.num_channels;
+}
+
+int AudioEncoderAacImpl::RtpTimestampRateHz() const {
+  return config_.sample_rate_hz;
+}
+
+size_t AudioEncoderAacImpl::Num10MsFramesInNextPacket() const {
+  size_t samples_per_frame = SamplesPerFrame() * config_.num_channels;
+  if (input_buffer_.size() >= samples_per_frame) {
+    return 1;
+  }
+  size_t samples_per_10ms = SamplesPer10ms() * config_.num_channels;
+  size_t missing = samples_per_frame - input_buffer_.size();
+  size_t frames_needed = (missing + samples_per_10ms - 1) / samples_per_10ms;
+  return std::max<size_t>(frames_needed, 1);
+}
+
+size_t AudioEncoderAacImpl::Max10MsFramesInAPacket() const {
+  size_t samples_per_10ms = SamplesPer10ms() * config_.num_channels;
+  size_t samples_per_frame = SamplesPerFrame() * config_.num_channels;
+  return (samples_per_frame + samples_per_10ms - 1) / samples_per_10ms;
+}
+
+int AudioEncoderAacImpl::GetTargetBitrate() const {
+  return target_bitrate_bps_;
+}
+
+void AudioEncoderAacImpl::Reset() {
+  platform_encoder_->Reset();
+  input_buffer_.clear();
+  timestamp_initialized_ = false;
+  next_rtp_timestamp_ = 0;
+}
+
+void AudioEncoderAacImpl::SetTargetBitrate(int bitrate_bps) {
+  target_bitrate_bps_ = bitrate_bps;
+  config_.bitrate_bps = bitrate_bps;
+  platform_encoder_->SetBitrate(bitrate_bps);
+}
+
+std::optional<std::pair<TimeDelta, TimeDelta>>
+AudioEncoderAacImpl::GetFrameLengthRange() const {
+  TimeDelta frame_length =
+      TimeDelta::Seconds(SamplesPerFrame()) / config_.sample_rate_hz;
+  return std::make_pair(frame_length, frame_length);
+}
+
+AudioEncoder::EncodedInfo AudioEncoderAacImpl::EncodeImpl(
+    uint32_t rtp_timestamp,
+    rtc::ArrayView<const int16_t> audio,
+    rtc::Buffer* encoded) {
+  input_buffer_.insert(input_buffer_.end(), audio.begin(), audio.end());
+  if (!timestamp_initialized_) {
+    next_rtp_timestamp_ = rtp_timestamp;
+    timestamp_initialized_ = true;
+  }
+
+  EncodedInfo frame_info = EncodeAacFrame(encoded);
+  frame_info.payload_type = payload_type_;
+  frame_info.encoder_type = CodecType::kAac;
+  frame_info.speech = true;
+  return frame_info;
+}
+
+AudioEncoder::EncodedInfo AudioEncoderAacImpl::EncodeAacFrame(
+    rtc::Buffer* encoded) {
+  EncodedInfo info;
+  info.payload_type = payload_type_;
+  info.encoder_type = CodecType::kAac;
+  info.speech = true;
+
+  size_t samples_per_frame = SamplesPerFrame() * config_.num_channels;
+  if (input_buffer_.size() < samples_per_frame) {
+    info.encoded_bytes = 0;
+    info.encoded_timestamp = next_rtp_timestamp_;
+    return info;
+  }
+
+  rtc::ArrayView<const int16_t> frame_pcm(input_buffer_.data(), samples_per_frame);
+  AacPlatformEncoder::EncodedFrame frame =
+      platform_encoder_->Encode(frame_pcm, config_.num_channels,
+                                config_.sample_rate_hz);
+  if (!frame.success) {
+    RTC_LOG(LS_WARNING) << "AAC platform encoder returned failure";
+    info.encoded_bytes = 0;
+    info.encoded_timestamp = next_rtp_timestamp_;
+    return info;
+  }
+
+  input_buffer_.erase(input_buffer_.begin(),
+                      input_buffer_.begin() + samples_per_frame);
+
+  rtc::Buffer packet =
+      RtpPacketizerAac::BuildSingleAuPacket(frame.aac_data);
+  encoded->EnsureCapacity(packet.size());
+  encoded->SetSize(packet.size());
+  std::memcpy(encoded->data(), packet.data(), packet.size());
+
+  info.encoded_bytes = encoded->size();
+  info.encoded_timestamp = next_rtp_timestamp_;
+  next_rtp_timestamp_ += SamplesPerFrame();
+  return info;
+}
+
+size_t AudioEncoderAacImpl::SamplesPerFrame() const {
+  return kAacSamplesPerFrame;
+}
+
+size_t AudioEncoderAacImpl::SamplesPer10ms() const {
+  return config_.sample_rate_hz / 100;
+}
+
+}  // namespace webrtc

