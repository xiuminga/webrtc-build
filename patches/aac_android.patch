@@ -0,0 +1,126 @@
+/*
+ *  Copyright (c) 2024 The WebRTC project authors. All Rights Reserved.
+ *
+ *  Use of this source code is governed by a BSD-style license
+ *  that can be found in the LICENSE file in the root of the source
+ *  tree. An additional intellectual property rights grant can be found
+ *  in the file PATENTS.  All contributing project authors may
+ *  be found in the AUTHORS file in the root of the source tree.
+ */
+
+#include "modules/audio_coding/codecs/aac/android/aac_platform_decoder_android.h"
+
+#include <algorithm>
+#include <memory>
+
+#include "rtc_base/checks.h"
+#include "rtc_base/logging.h"
+
+namespace webrtc {
+
+namespace {
+
+constexpr int kSupportedSampleRate = 48000;
+constexpr int kMaxChannels = 2;
+
+}  // namespace
+
+AacPlatformDecoderAndroid::AacPlatformDecoderAndroid(const Config& config)
+    : config_(config),
+      decoder_initialized_(false),
+      media_codec_decoder_(nullptr) {
+  RTC_CHECK_EQ(config_.sample_rate_hz, kSupportedSampleRate);
+  RTC_CHECK_LE(config_.num_channels, kMaxChannels);
+  
+  InitDecoder();
+}
+
+AacPlatformDecoderAndroid::~AacPlatformDecoderAndroid() {
+  ReleaseDecoder();
+}
+
+bool AacPlatformDecoderAndroid::InitDecoder() {
+  RTC_LOG(LS_INFO) << "AacPlatformDecoderAndroid::InitDecoder() - "
+                   << "sample_rate=" << config_.sample_rate_hz
+                   << " channels=" << config_.num_channels;
+
+  // TODO: Initialize Android MediaCodec decoder
+  // This requires JNI calls to:
+  // 1. Create MediaCodec instance with "audio/mp4a-latm" mime type
+  // 2. Configure with MediaFormat (sample rate, channels)
+  // 3. Start the decoder
+  
+  decoder_initialized_ = false;  // Will be true after MediaCodec init
+  RTC_LOG(LS_WARNING) << "MediaCodec AAC decoder initialization not yet implemented";
+  
+  return decoder_initialized_;
+}
+
+void AacPlatformDecoderAndroid::ReleaseDecoder() {
+  if (decoder_initialized_) {
+    // TODO: Release MediaCodec decoder
+    // This requires JNI calls to:
+    // 1. Stop the decoder
+    // 2. Release MediaCodec instance
+    
+    decoder_initialized_ = false;
+    media_codec_decoder_ = nullptr;
+  }
+}
+
+int AacPlatformDecoderAndroid::SampleRateHz() const {
+  return config_.sample_rate_hz;
+}
+
+size_t AacPlatformDecoderAndroid::Channels() const {
+  return config_.num_channels;
+}
+
+int AacPlatformDecoderAndroid::DecodeInternal(const uint8_t* encoded,
+                                               size_t encoded_len,
+                                               int sample_rate_hz,
+                                               int16_t* decoded,
+                                               SpeechType* speech_type) {
+  if (!decoder_initialized_) {
+    RTC_LOG(LS_WARNING) << "AAC decoder not initialized";
+    return -1;
+  }
+
+  RTC_CHECK_EQ(sample_rate_hz, config_.sample_rate_hz);
+
+  // TODO: Implement AAC decoding using MediaCodec
+  // This requires:
+  // 1. Get input buffer from MediaCodec
+  // 2. Copy encoded AAC data to input buffer
+  // 3. Queue input buffer
+  // 4. Dequeue output buffer
+  // 5. Copy decoded PCM data to decoded buffer
+  // 6. Release output buffer
+  
+  // For now, return 0 samples decoded
+  RTC_LOG(LS_VERBOSE) << "AAC decoding not yet implemented - "
+                      << "encoded_len=" << encoded_len
+                      << " sample_rate=" << sample_rate_hz;
+  
+  *speech_type = kSpeech;
+  return 0;
+}
+
+void AacPlatformDecoderAndroid::Reset() {
+  RTC_LOG(LS_INFO) << "AacPlatformDecoderAndroid::Reset()";
+  ReleaseDecoder();
+  InitDecoder();
+}
+
+}  // namespace webrtc
