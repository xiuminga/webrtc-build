+
+#ifndef MODULES_AUDIO_CODING_CODECS_AAC_ANDROID_AAC_PLATFORM_ENCODER_ANDROID_H_
+#define MODULES_AUDIO_CODING_CODECS_AAC_ANDROID_AAC_PLATFORM_ENCODER_ANDROID_H_
+
+#include <memory>
+#include <vector>
+
+#include "api/audio_codecs/audio_encoder.h"
+#include "rtc_base/buffer.h"
+
+namespace webrtc {
+
+// AAC encoder implementation using Android MediaCodec
+class AacPlatformEncoderAndroid final : public AudioEncoder {
+ public:
+  struct Config {
+    int sample_rate_hz = 48000;
+    int num_channels = 2;
+    int bitrate_bps = 128000;
+    int frame_size_ms = 20;
+  };
+
+  explicit AacPlatformEncoderAndroid(const Config& config, int payload_type);
+  ~AacPlatformEncoderAndroid() override;
+
+  AacPlatformEncoderAndroid(const AacPlatformEncoderAndroid&) = delete;
+  AacPlatformEncoderAndroid& operator=(const AacPlatformEncoderAndroid&) = delete;
+
+  int SampleRateHz() const override;
+  size_t NumChannels() const override;
+  size_t Num10MsFramesInNextPacket() const override;
+  size_t Max10MsFramesInAPacket() const override;
+  int GetTargetBitrate() const override;
+
+  EncodedInfo EncodeImpl(uint32_t rtp_timestamp,
+                         rtc::ArrayView<const int16_t> audio,
+                         rtc::Buffer* encoded) override;
+  void Reset() override;
+
+ private:
+  bool InitEncoder();
+  void ReleaseEncoder();
+
+  const Config config_;
+  const int payload_type_;
+  bool encoder_initialized_;
+  
+  // Android MediaCodec encoder handle (using JNI)
+  void* media_codec_encoder_;
+  
+  // Encoding state
+  std::vector<uint8_t> input_buffer_;
+  int64_t num_10ms_frames_per_packet_;
+};
+
+}  // namespace webrtc
+
+#endif  // MODULES_AUDIO_CODING_CODECS_AAC_ANDROID_AAC_PLATFORM_ENCODER_ANDROID_H_
diff --git a/modules/audio_coding/codecs/aac/android/aac_platform_encoder_android.cc b/modules/audio_coding/codecs/aac/android/aac_platform_encoder_android.cc
