+
+#include <memory>
+#include <vector>
+
+#include "api/audio_codecs/audio_decoder.h"
+
+namespace webrtc {
+
+// AAC decoder implementation using Android MediaCodec
+class AacPlatformDecoderAndroid final : public AudioDecoder {
+ public:
+  struct Config {
+    int sample_rate_hz = 48000;
+    int num_channels = 2;
+  };
+
+  explicit AacPlatformDecoderAndroid(const Config& config);
+  ~AacPlatformDecoderAndroid() override;
+
+  AacPlatformDecoderAndroid(const AacPlatformDecoderAndroid&) = delete;
+  AacPlatformDecoderAndroid& operator=(const AacPlatformDecoderAndroid&) = delete;
+
+  int SampleRateHz() const override;
+  size_t Channels() const override;
+
+  int DecodeInternal(const uint8_t* encoded,
+                     size_t encoded_len,
+                     int sample_rate_hz,
+                     int16_t* decoded,
+                     SpeechType* speech_type) override;
+  void Reset() override;
+
+ private:
+  bool InitDecoder();
+  void ReleaseDecoder();
+
+  const Config config_;
+  bool decoder_initialized_;
+  
+  // Android MediaCodec decoder handle (using JNI)
+  void* media_codec_decoder_;
+};
+
+}  // namespace webrtc
